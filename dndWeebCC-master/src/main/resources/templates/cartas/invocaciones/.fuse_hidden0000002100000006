<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Editor de carta de invocación</title>
    <link th:href="@{/css/tokens.css}" rel="stylesheet">
    <link th:href="@{/css/base.css}" rel="stylesheet">
    <link th:href="@{/css/components.css}" rel="stylesheet">
</head>
<body>
<div class="gm-app">
    <div th:replace="~{Blocks/header-v2 :: header}"></div>
    <div class="gm-body">
        <div th:replace="~{Blocks/sidebar-v2 :: sidebar}"></div>
        <main class="gm-main">
            <div th:replace="~{Blocks/cartas-subnav-v2 :: subnav('invocaciones')}"></div>
            <p class="gm-sidebar__eyebrow" style="padding:0;">Sistema de Cartas y Tiers</p>
            <h1 th:text="${esNueva} ? 'Nueva carta de invocación' : 'Editar carta de invocación'" style="margin-bottom: var(--sp-5);">Nueva carta de invocación</h1>

            <form th:action="${esNueva} ? @{/cartas/invocaciones} : @{/cartas/invocaciones/{id}/editar(id=${form.id})}"
                  th:object="${form}" method="post">

                <div class="gm-form-grid" style="margin-bottom: var(--sp-4);">
                    <div class="gm-field" th:if="${esNueva}">
                        <label>ID (opcional)</label>
                        <input class="gm-input" th:field="*{id}" placeholder="Se genera automático a partir del nombre">
                    </div>
                    <div class="gm-field" th:unless="${esNueva}">
                        <label>ID</label>
                        <input class="gm-input" th:field="*{id}" readonly>
                    </div>
                    <div class="gm-field">
                        <label>Nombre</label>
                        <input class="gm-input" th:field="*{name}" placeholder="Lobo Espectral" required>
                    </div>
                    <div class="gm-field">
                        <label>Invocada por (id de habilidad/hechizo)</label>
                        <input class="gm-input" th:field="*{summonedBy}" placeholder="spell_summon_spectral_wolf">
                    </div>
                    <div class="gm-field">
                        <label>Tier</label>
                        <input class="gm-input" type="number" min="0" max="5" th:field="*{tier}">
                    </div>
                </div>

                <div class="gm-panel-section is-expanded">
                    <button type="button" class="gm-panel-section__toggle">Estadísticas ▾</button>
                    <div class="gm-panel-section__content">
                        <div class="gm-form-grid">
                            <div class="gm-field">
                                <label>Vida</label>
                                <input class="gm-input" type="number" min="0" th:field="*{health}">
                            </div>
                            <div class="gm-field">
                                <label>Movimiento</label>
                                <input class="gm-input" type="number" min="0" th:field="*{movement}">
                            </div>
                            <div class="gm-field">
                                <label>Duración</label>
                                <select class="gm-select" th:field="*{duration}">
                                    <option value="instant">Instantánea</option>
                                    <option value="1_turn">1 turno</option>
                                    <option value="1_min">1 minuto</option>
                                    <option value="concentration">Concentración</option>
                                    <option value="permanent">Permanente</option>
                                </select>
                            </div>
                            <div class="gm-field">
                                <label>Control</label>
                                <select class="gm-select" th:field="*{control}">
                                    <option value="automatica">Automática</option>
                                    <option value="jugador">Jugador</option>
                                    <option value="car_invocador">CAR del invocador</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="gm-panel-section is-expanded">
                    <button type="button" class="gm-panel-section__toggle">Ataques ▾</button>
                    <div class="gm-panel-section__content">
                        <div class="gm-field">
                            <label>Ataques (uno por línea o separados por ";", formato "Nombre: efecto")</label>
                            <textarea class="gm-textarea" rows="3" th:field="*{attacks}" placeholder="Mordisco: 1d6 físico; Aullido: impone Asustado"></textarea>
                        </div>
                    </div>
                </div>

                <div class="gm-panel-section is-expanded">
                    <button type="button" class="gm-panel-section__toggle">Pasiva y texto narrativo ▾</button>
                    <div class="gm-panel-section__content">
                        <div class="gm-form-grid">
                            <div class="gm-field">
                                <label>Nombre de la pasiva</label>
                                <input class="gm-input" th:field="*{passiveName}">
                            </div>
                            <div class="gm-field" style="grid-column: 1 / -1;">
                                <label>Descripción de la pasiva</label>
                                <textarea class="gm-textarea" rows="2" th:field="*{passiveDescription}"></textarea>
                            </div>
                            <div class="gm-field">
                                <label>Texto narrativo</label>
                                <input class="gm-input" th:field="*{flavorText}">
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display:flex; gap: var(--sp-2); margin-top: var(--sp-4);">
                    <button class="gm-btn gm-btn--primary" type="submit">Guardar</button>
                    <a class="gm-btn gm-btn--outline" th:href="@{/cartas/invocaciones}">Cancelar</a>
                </div>
            </form>
        </main>
    </div>
    <div th:replace="~{Blocks/footer-v2 :: footer}"></div>
</div>
<script th:src="@{/js/theme.js}"></script>
<script th:src="@{/js/panels.js}"></script>
</body>
</html>
