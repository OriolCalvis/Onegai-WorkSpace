<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Editor de carta de dote</title>
    <link th:href="@{/css/tokens.css}" rel="stylesheet">
    <link th:href="@{/css/base.css}" rel="stylesheet">
    <link th:href="@{/css/components.css}" rel="stylesheet">
</head>
<body>
<div class="gm-app">
    <div th:replace="~{Blocks/header-v2 :: header}"></div>
    <div class="gm-body">
        <div th:replace="~{Blocks/sidebar-v2 :: sidebar}"></div>
        <main class="gm-main">
            <div th:replace="~{Blocks/cartas-subnav-v2 :: subnav('dotes')}"></div>
            <p class="gm-sidebar__eyebrow" style="padding:0;">Sistema de Cartas y Tiers</p>
            <h1 th:text="${esNueva} ? 'Nueva carta de dote' : 'Editar carta de dote'" style="margin-bottom: var(--sp-5);">Nueva carta de dote</h1>

            <form th:action="${esNueva} ? @{/cartas/dotes} : @{/cartas/dotes/{id}/editar(id=${form.id})}"
                  th:object="${form}" method="post">

                <div class="gm-form-grid" style="margin-bottom: var(--sp-4);">
                    <div class="gm-field" th:if="${esNueva}">
                        <label>ID (opcional)</label>
                        <input class="gm-input" th:field="*{id}" placeholder="Se genera automático a partir del nombre">
                    </div>
                    <div class="gm-field" th:unless="${esNueva}">
                        <label>ID</label>
                        <input class="gm-input" th:field="*{id}" readonly>
                    </div>
                    <div class="gm-field">
                        <label>Nombre</label>
                        <input class="gm-input" th:field="*{name}" placeholder="Reflejos de Acero" required>
                    </div>
                    <div class="gm-field">
                        <label>Tier</label>
                        <input class="gm-input" type="number" min="0" max="5" th:field="*{tier}">
                    </div>
                    <div class="gm-field">
                        <label>Rareza</label>
                        <select class="gm-select" th:field="*{rarity}">
                            <option value="common">Común</option>
                            <option value="uncommon">Poco común</option>
                            <option value="rare">Rara</option>
                            <option value="epic">Épica</option>
                        </select>
                    </div>
                </div>

                <div class="gm-panel-section is-expanded">
                    <button type="button" class="gm-panel-section__toggle">Clasificación y requisitos ▾</button>
                    <div class="gm-panel-section__content">
                        <div class="gm-form-grid">
                            <div class="gm-field">
                                <label>Clases (tags)</label>
                                <input class="gm-input" th:field="*{classTags}" placeholder="sable_errante, arcanista">
                            </div>
                            <div class="gm-field">
                                <label>Tags concedidos</label>
                                <input class="gm-input" th:field="*{grantedTags}">
                            </div>
                            <div class="gm-field">
                                <label>Requiere CON</label>
                                <input class="gm-input" type="number" min="0" th:field="*{reqCon}">
                            </div>
                            <div class="gm-field">
                                <label>Requiere DES</label>
                                <input class="gm-input" type="number" min="0" th:field="*{reqDes}">
                            </div>
                            <div class="gm-field">
                                <label>Requiere CAR</label>
                                <input class="gm-input" type="number" min="0" th:field="*{reqCar}">
                            </div>
                            <div class="gm-field">
                                <label>Requiere INT</label>
                                <input class="gm-input" type="number" min="0" th:field="*{reqInt}">
                            </div>
                            <div class="gm-field">
                                <label>Tags requeridos</label>
                                <input class="gm-input" th:field="*{requiredTags}">
                            </div>
                            <div class="gm-field">
                                <label>Tags incompatibles</label>
                                <input class="gm-input" th:field="*{incompatibleTags}">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="gm-panel-section is-expanded">
                    <button type="button" class="gm-panel-section__toggle">Efecto ▾</button>
                    <div class="gm-panel-section__content">
                        <div class="gm-form-grid">
                            <div class="gm-field" style="grid-column: 1 / -1;">
                                <label>Descripción del efecto</label>
                                <textarea class="gm-textarea" rows="3" th:field="*{effectDescription}"></textarea>
                            </div>
                            <div class="gm-field">
                                <label>Escalado</label>
                                <input class="gm-input" th:field="*{effectScaling}" placeholder="con_tier, none">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="gm-panel-section">
                    <button type="button" class="gm-panel-section__toggle">Limitaciones y texto narrativo ▾</button>
                    <div class="gm-panel-section__content">
                        <div class="gm-form-grid">
                            <div class="gm-field">
                                <label>Limitaciones</label>
                                <input class="gm-input" th:field="*{limitations}">
                            </div>
                            <div class="gm-field">
                                <label>Texto narrativo</label>
                                <input class="gm-input" th:field="*{flavorText}">
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display:flex; gap: var(--sp-2); margin-top: var(--sp-4);">
                    <button class="gm-btn gm-btn--primary" type="submit">Guardar</button>
                    <a class="gm-btn gm-btn--outline" th:href="@{/cartas/dotes}">Cancelar</a>
                </div>
            </form>
        </main>
    </div>
    <div th:replace="~{Blocks/footer-v2 :: footer}"></div>
</div>
<script th:src="@{/js/theme.js}"></script>
<script th:src="@{/js/panels.js}"></script>
</body>
</html>
