{
  "objects": [
    {
      "id": "bg_mes_de_la_cosecha",
      "name": "Mes de la Cosecha",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Villas de mercado donde el campo y la ciudad se dan la mano (y se la miden).",
          "culture": "Contar bien es tan sagrado como sembrar bien; la balanza es un altar.",
          "environment": "Graneros, básculas, caminos de carro y ferias de cierre de año.",
          "importantEvents": [
            "La Cosecha Partida, que se repartió con el pueblo vecino en su peor año",
            "El Pleito de las Balanzas, que dio al pueblo su fuero propio"
          ],
          "deities": [
            "la_espiga_dorada",
            "el_hermano_mendigo"
          ],
          "symbols": [
            "La balanza equilibrada",
            "La gavilla atada",
            "La llave del granero"
          ],
          "traditions": [
            "El primer pan de la cosecha se hornea para desconocidos",
            "Revisar las cuentas del año en voz alta, ante todos"
          ]
        },
        "_description": "Los nacidos cuando se recoge: trabajadores incansables, confiables, generosos con lo suyo y exigentes con lo justo."
      }
    },
    {
      "id": "bg_mes_de_la_siembra",
      "name": "Mes de la Siembra",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Comunidades agrícolas del valle, donde cada familia tiene surco y palabra.",
          "culture": "El pacto vale más que el contrato; la cosecha se comparte antes de contarse.",
          "environment": "Campos abiertos, acequias, silos comunales y ferias de semillas.",
          "importantEvents": [
            "El Año sin Siembra, cuando la guerra pisó los campos",
            "La fundación del banco de semillas del valle"
          ],
          "deities": [
            "la_espiga_dorada",
            "la_madre_de_los_doce"
          ],
          "symbols": [
            "La semilla en la palma",
            "El arado pequeño",
            "El nudo de espigas"
          ],
          "traditions": [
            "Plantar algo el día del nacimiento de cada hijo",
            "Sellar los tratos con tierra en la mano, no con tinta"
          ]
        },
        "_description": "Los nacidos cuando se abre la tierra: pacientes, protectores, incapaces de abandonar lo que empezaron a cuidar."
      }
    },
    {
      "id": "bg_mes_de_la_terra",
      "name": "Mes de la Tierra",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Fronteras duras y colonias jóvenes, donde la tierra se gana cada día.",
          "culture": "Primero el refugio, luego el muro, luego la mesa larga para todos.",
          "environment": "Territorio hostil domesticado a paciencia: empalizadas, pozos, primeros huertos.",
          "importantEvents": [
            "La Primera Empalizada, levantada en una sola noche entre todos",
            "El Invierno de las Puertas Abiertas, cuando nadie durmió fuera"
          ],
          "deities": [
            "el_toro_de_gongorguma",
            "la_espiga_dorada"
          ],
          "symbols": [
            "La piedra angular",
            "El pozo compartido",
            "La mesa larga"
          ],
          "traditions": [
            "Poner la primera piedra de toda casa entre todos los vecinos",
            "Quien llega de fuera come primero y explica después"
          ]
        },
        "_description": "Los nacidos del suelo firme: arraigados, pacientes, rápidos para defender y lentos para atacar."
      }
    },
    {
      "id": "bg_mes_de_lagonia",
      "name": "Mes de la Agonía",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Pueblos de duelo largo, donde los funerales duran lo que haga falta.",
          "culture": "Nombrar el dolor es curarlo a medias; el arte triste es medicina.",
          "environment": "Alamedas en otoño perpetuo, talleres de luthier, cementerios con bancos.",
          "importantEvents": [
            "La Peste Blanca que enseñó al pueblo a despedirse bien",
            "El Concurso de Elegías, que se celebra desde entonces"
          ],
          "deities": [
            "el_sepulturero_amable",
            "la_madre_de_los_doce"
          ],
          "symbols": [
            "La hoja a medio caer",
            "La cuerda de laúd rota y anudada",
            "La vela que gotea"
          ],
          "traditions": [
            "Componer una canción para cada difunto, aunque sea de dos versos",
            "Guardar un asiento vacío en cada celebración"
          ]
        },
        "_description": "Los nacidos en la caída de la hoja: profundos, persistentes en el dolor, capaces de acompañar cualquier pena."
      }
    },
    {
      "id": "bg_mes_de_laigua",
      "name": "Mes del Agua",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Pueblos ribereños y barrios de canal, donde todo llega y todo se va flotando.",
          "culture": "Se aprende nadando y se discute remando; la prisa es de secano.",
          "environment": "Ríos lentos, molinos, embarcaderos con historias y niebla madrugadora.",
          "importantEvents": [
            "La Crecida que movió el pueblo entero cien pasos",
            "El año que el río bajó rojo y nadie supo por qué"
          ],
          "deities": [
            "la_senora_de_las_mareas",
            "la_luna_hueca"
          ],
          "symbols": [
            "La gota que horada",
            "El remo cruzado",
            "La caracola de agua dulce"
          ],
          "traditions": [
            "Confiar los secretos al río, en voz baja, una vez al año",
            "No zarpar jamás sin devolver algo a la orilla"
          ]
        },
        "_description": "Los nacidos con las lluvias largas: soñadores lúcidos, flexibles, con memoria de cauce."
      }
    },
    {
      "id": "bg_mes_de_les_estrelles",
      "name": "Mes de las Estrellas",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Observatorios, faros del interior y aldeas que guardan la Noche de las Tres Lunas.",
          "culture": "Mirar el cielo es un oficio; anotarlo, un deber; interpretarlo, un riesgo asumido.",
          "environment": "Cúpulas con grietas de tanto abrirse, mapas celestes, escaleras de caracol.",
          "importantEvents": [
            "La Noche de las Tres Lunas, que solo ocurre cada generación",
            "El Error del Cometa, cuando una mala lectura movió una guerra"
          ],
          "deities": [
            "la_tejedora_de_estrellas",
            "el_oraculo_fragmentado"
          ],
          "symbols": [
            "Las tres lunas alineadas",
            "El hilo rojo anudado",
            "El astrolabio heredado"
          ],
          "traditions": [
            "Anotar la posición de las estrellas en cada nacimiento del pueblo",
            "Deshacer un nudo el día del error propio, en público"
          ]
        },
        "_description": "Los nacidos bajo la conjunción: sagaces, compasivos a escala de mundo, viejos desde la cuna."
      }
    },
    {
      "id": "bg_mes_de_les_ombres",
      "name": "Mes de las Sombras",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Callejones de ciudad vieja y barrios que la historia oficial prefiere no contar.",
          "culture": "Sobrevivir con estilo es la única etiqueta; las cadenas se estudian para romperse.",
          "environment": "Faroles rojos, tejados comunicados, tabernas con dos salidas y media.",
          "importantEvents": [
            "El Toque de Queda de los Tres Años, y cómo se burló cada noche",
            "La Noche de los Faroles, cuando el barrio se defendió solo"
          ],
          "deities": [
            "la_dama_del_farol_rojo",
            "deity_veiled_queen"
          ],
          "symbols": [
            "El farol rojo",
            "La llave maestra",
            "La cicatriz con historia"
          ],
          "traditions": [
            "No preguntar el nombre de nacimiento: vale el elegido",
            "Pagar la primera ronda a quien acaba de llegar huyendo de algo"
          ]
        },
        "_description": "Los nacidos en la frontera de la luz: perspicaces, adaptables, valientes ante su propia oscuridad."
      }
    },
    {
      "id": "bg_mes_de_lescarcha",
      "name": "Mes de la Escarcha",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Aldeas altas donde el invierno dura medio año y las bibliotecas son graneros de palabras.",
          "culture": "Se valora el silencio bien usado: hablar poco y anotar mucho.",
          "environment": "Bosques escarchados, ermitas, senderos que solo existen en deshielo.",
          "importantEvents": [
            "La Gran Helada que enterró los caminos un año entero",
            "La llegada del primer archivo itinerante a las aldeas altas"
          ],
          "deities": [
            "el_caminante_gris",
            "deity_wild_court"
          ],
          "symbols": [
            "La hoja cubierta de escarcha",
            "El farol apagado al alba",
            "El libro con cierre de hielo"
          ],
          "traditions": [
            "Escribir el primer pensamiento del año en hielo, para que se derrita",
            "No interrumpir jamás a quien mira el fuego"
          ]
        },
        "_description": "Los nacidos cuando el año se cierra en silencio: introspectivos, serenos, con una conexión mística con lo que duerme bajo la nieve."
      }
    },
    {
      "id": "bg_mes_de_loracle",
      "name": "Mes del Oráculo",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Colinas del este, donde el cielo roto deja caer presagios con la lluvia.",
          "culture": "Se respeta a quien tuvo una visión... y se le vigila de cerca.",
          "environment": "Mesetas de tormenta, círculos de piedras que zumban, atalayas de vigía.",
          "importantEvents": [
            "La noche en que el Cielo se fragmentó sobre las colinas",
            "La Profecía de las Tres Puertas, aún a medio cumplir"
          ],
          "deities": [
            "el_oraculo_fragmentado",
            "la_madre_de_los_doce"
          ],
          "symbols": [
            "El rayo bifurcado",
            "El ojo entre nubes",
            "La campana rajada que aún suena"
          ],
          "traditions": [
            "Anotar los sueños al despertar, antes de hablar con nadie",
            "Subir a la atalaya en cada tormenta para 'escuchar el correo'"
          ]
        },
        "_description": "Los nacidos bajo el Cielo Fragmentado: visionarios eléctricos, valientes ante lo desconocido, difíciles de sujetar."
      }
    },
    {
      "id": "bg_mes_del_ferro",
      "name": "Mes del Hierro",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Ciudades-fragua y pasos de montaña donde la ley llegó a martillazos.",
          "culture": "El honor se mide en lo que aguantas y en a quién no abandonaste.",
          "environment": "Herrerías, cuarteles, murallas a medio reparar, banderas gastadas.",
          "importantEvents": [
            "El Asedio de los Cien Días que la villa resistió",
            "El Juramento del Yunque, que fundó la guardia libre"
          ],
          "deities": [
            "la_forja_del_trueno",
            "deity_forge_father"
          ],
          "symbols": [
            "El martillo alzado",
            "El eslabón abierto",
            "La bandera remendada"
          ],
          "traditions": [
            "Forjar un clavo el día de la mayoría de edad y clavarlo en la puerta común",
            "Jurar los cargos ante el yunque, no ante el altar"
          ]
        },
        "_description": "Los nacidos al rojo: valientes, leales hasta la muerte, resolutivos cuando todo tiembla."
      }
    },
    {
      "id": "bg_mes_del_sol",
      "name": "Mes del Sol",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Vegas soleadas y pueblos de fiesta larga, donde el verano se toma en serio.",
          "culture": "La alegría es un oficio respetable; la belleza, un servicio público.",
          "environment": "Campos en flor, plazas con música, colmenas y huertos desbordados.",
          "importantEvents": [
            "El Verano Doble, cuando no llegó el otoño",
            "La fundación de la Fiesta de las Primeras Flores"
          ],
          "deities": [
            "el_leon_del_alba",
            "deity_wild_court"
          ],
          "symbols": [
            "El girasol",
            "La abeja dorada",
            "La corona de flores frescas"
          ],
          "traditions": [
            "Regalar lo primero que florezca de cada huerto",
            "Bailar al amanecer del primer día cálido, esté quien esté mirando"
          ]
        },
        "_description": "Los nacidos en pleno esplendor: radiantes, protectores de la vida, incapaces de pasar desapercibidos."
      }
    },
    {
      "id": "bg_mes_dels_aullits",
      "name": "Mes de los Aullidos",
      "category": "prop",
      "spriteId": -1,
      "blocksMovement": false,
      "interactable": true,
      "_sourceData": {
        "_tipo": "trasfondo",
        "_tier": 1,
        "_type": "BACKGROUND",
        "_lore": {
          "origin": "Aldeas junto a campos santos y pasos de montaña donde el viento aúlla nombres.",
          "culture": "A los muertos se les habla con normalidad; a la muerte, con respeto y sin miedo.",
          "environment": "Nieblas bajas, cipreses, linternas votivas, senderos de peregrinación nocturna.",
          "importantEvents": [
            "La Noche de los Mil Aullidos, cuando el paso se cerró solo",
            "La fundación de la Vigilia, la orden que acompaña moribundos"
          ],
          "deities": [
            "deity_wolf_king",
            "el_sepulturero_amable"
          ],
          "symbols": [
            "La linterna votiva",
            "El ciprés joven",
            "La huella de lobo en la escarcha"
          ],
          "traditions": [
            "Dejar una luz encendida en la ventana las noches de viento",
            "Contar los nombres de los idos en el solsticio, todos, sin saltarse uno"
          ]
        },
        "_description": "Los nacidos en las noches largas: introspectivos, fieles a sus intuiciones, valientes ante la muerte."
      }
    },
