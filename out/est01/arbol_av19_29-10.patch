+        for (int i = 0; i < n; ++i) {
+            const float a = alas[i].alfa * (luz ? 0.12f * pulso : 0.10f);
+            pinta(alas[i], luz ? Vector4{1.0f, 0.95f, 0.82f, a} : Vector4{1.0f, 0.22f, 0.30f, a});
