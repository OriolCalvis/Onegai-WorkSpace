+int gradoAura(int valorMoral) {
+    const int v = std::clamp(valorMoral, -100, 100);
+    const int a = v < 0 ? -v : v;
+    int g = 0;
+    for (int i = 0; i < kGradosPorLado; ++i)
+        if (a >= kCorteGrado[i]) g = i + 1;
+    return v < 0 ? -g : g;
+}
