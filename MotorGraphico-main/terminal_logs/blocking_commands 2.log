  --done-bg:#1B2A20; --parcial-bg:#2E2617; --pend-bg:#22252F; --repl-bg:#2E1D19;
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 8px 24px -16px rgba(0,0,0,.7);
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--ground); color:var(--ink);
  font-family:"Archivo","Helvetica Neue",Arial,sans-serif;
  font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1180px; margin:0 auto; padding:0 24px 96px}
h1,h2,h3{font-family:"Bitter",Georgia,serif; text-wrap:balance; margin:0}
a{color:var(--accent)}
.mono{font-family:"IBM Plex Mono",ui-monospace,Menlo,monospace; font-variant-numeric:tabular-nums}

/* ---------- cabecera ---------- */
header{padding:56px 0 32px; border-bottom:1px solid var(--line)}
.eyebrow{font-family:"IBM Plex Mono",monospace; font-size:11.5px; letter-spacing:.14em;
  text-transform:uppercase; color:var(--faint)}
h1{font-size:clamp(30px,4.4vw,46px); font-weight:700; letter-spacing:-.015em; margin:10px 0 12px}
.lede{max-width:64ch; color:var(--muted); font-size:16.5px}
.lede strong{color:var(--ink); font-weight:600}

/* ---------- kpis ---------- */
.kpis{display:grid; grid-template-columns:repeat(auto-fit,minmax(168px,1fr)); gap:1px;
  background:var(--line); border:1px solid var(--line); border-radius:10px;
  overflow:hidden; margin:32px 0 0}
.kpi{background:var(--card); padding:18px 20px}
.kpi .v{font-family:"Bitter",serif; font-size:31px; font-weight:700; line-height:1.1;
  letter-spacing:-.02em; font-variant-numeric:tabular-nums}
.kpi .k{font-size:12.5px; color:var(--muted); margin-top:4px}
.kpi .sub{font-size:11.5px; color:var(--faint); margin-top:2px}

/* ---------- secciones ---------- */
section{margin-top:52px}
.sec-head{display:flex; align-items:baseline; gap:14px; margin-bottom:18px;
  padding-bottom:10px; border-bottom:1px solid var(--line)}
.sec-head h2{font-size:19px; font-weight:700; letter-spacing:-.01em}
.sec-head .note{font-size:13px; color:var(--faint)}

/* ---------- fases ---------- */
.fases{display:flex; flex-direction:column; gap:2px}
.fase{display:grid; grid-template-columns:minmax(180px,1.4fr) 1fr 78px 78px;
  gap:16px; align-items:center; padding:9px 12px; border-radius:7px;
  background:none; border:0; width:100%; text-align:left; cursor:pointer;
  color:inherit; font:inherit}
.fase:hover{background:var(--card)}
.fase[aria-pressed="true"]{background:var(--accent-soft); box-shadow:inset 2px 0 0 var(--accent)}
.fase .nm{font-weight:500; font-size:13.5px}
.fase .nm em{font-style:normal; color:var(--faint); font-size:12px; margin-left:6px}
.bar{height:9px; border-radius:5px; background:var(--pend-bg); overflow:hidden; display:flex}
.bar i{display:block; height:100%}
.fase .num{text-align:right; font-size:13px; color:var(--muted)}
.fase .num b{color:var(--ink); font-weight:600}

/* ---------- corte recomendado ---------- */
.cortes{display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:14px}
.corte{background:var(--card); border:1px solid var(--line); border-radius:10px; padding:18px 20px}
.corte.pick{border-color:var(--accent); box-shadow:var(--shadow)}
.corte h3{font-size:15.5px; font-weight:700; margin-bottom:6px}
.corte p{margin:0; font-size:13.5px; color:var(--muted)}
.corte .cost{margin-top:12px; font-family:"IBM Plex Mono",monospace; font-size:12.5px;
  color:var(--accent); font-weight:600}
.pick-tag{display:inline-block; font-family:"IBM Plex Mono",monospace; 


