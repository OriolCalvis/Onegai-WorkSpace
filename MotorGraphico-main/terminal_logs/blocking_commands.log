Result<bool> ProjectIndex::addLevelToProject(const std::string& assetsRoot,
                                             const std::string& projectId,
                                             const std::string& levelFileName) {
    if (!validId(projectId)) {
        return Result<bool>::Error("id de proyecto invalido");
    }
    // Un nombre con separadores saldria de la carpeta de niveles. El
    // manifiesto guarda un NOMBRE DE FICHERO, no una ruta: aceptar
    // "../../etc/passwd" o "sub/dir/x.json" lo convertiria en otra cosa.
    if (levelFileName.empty() || levelFileName.find('/') != std::string::npos ||
        levelFileName.find('\\') != std::string::npos) {
        return Result<bool>::Error("nombre de fichero de nivel invalido: '" + levelFileName + "'");
    }

    const std::string manifiesto = assetsRoot + "/proyectos/" + projectId + ".json";
    std::string texto;
    if (!leeFichero(manifiesto, texto)) {
        return Result<bool>::Error("no existe un proyecto con id '" + projectId + "'");
    }
    Result<Project> leido = ProjectSerializer::deserializeProject(texto);
    if (!leido.isOk()) {
        return Result<bool>::Error("manifiesto invalido: " + leido.errorMessage());
    }
    Project proyecto = std::move(leido.value());

    // El nivel tiene que existir de verdad. Anadir al manifiesto un
    // fichero que no esta deja un proyecto que el editor lista y no puede
    // abrir, y el fallo aparece mucho despues de esta llamada.
    const std::string ruta =
        assetsRoot + "/" + proyecto.settings.levelsDirectory + "/" + levelFileName;
    if (!existe(ruta)) {
        return Result<bool>::Error("el nivel no existe: " + ruta);
    }

    // Idempotente, como promete el header: volver a anadir el mismo nivel
    // no es un error ni lo duplica. Un generador que se ejecuta dos veces
    // es lo normal, no la excepcion.
    for (const std::string& existente : proyecto.levels) {
        if (existente == levelFileName) {
            return Result<bool>::Ok(true);
        }
    }
    proyecto.levels.push_back(levelFileName);

    const Result<bool> valido = proyecto.validate();
    if (!valido.isOk()) {
        return Result<bool>::Error("el proyecto quedaria invalido: " + valido.errorMessage());
    }
    return ProjectSerializer::saveProjectAtomic(manifiesto, proyecto);
}

