# AV13-33 — Las cicatrices que deja morir (Game::Cicatrices). GL-free.
if(BUILD_TESTING AND TARGET motor_level)
    add_executable(test_cicatrices tests/Game/CicatricesTests.cpp)
    target_include_directories(test_cicatrices PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/tests")
    target_link_libraries(test_cicatrices PRIVATE motor_level motor_json)
    if(TARGET copiar_assets)
        add_dependencies(test_cicatrices copiar_assets)
    endif()
    add_test(NAME test_cicatrices COMMAND test_cicatrices)
    set_tests_properties(test_cicatrices PROPERTIES WORKING_DIRECTORY "${CMAKE_BINARY_DIR}" LABELS "unit;gl-free")
    set_property(GLOBAL APPEND PROPERTY MOTOR_GL_FREE_TARGETS test_cicatrices)
    if(TARGET suite_gl_free)
        add_dependencies(suite_gl_free test_cicatrices)
    endif()
endif()
