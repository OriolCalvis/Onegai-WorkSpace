    add_executable(test_efectos_de_golpe tests/Game/EfectosDeGolpeTests.cpp)
    target_include_directories(test_efectos_de_golpe PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/tests")
    target_link_libraries(test_efectos_de_golpe PRIVATE motor_level motor_json)
