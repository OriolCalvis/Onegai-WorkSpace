{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MotorGraphico Map v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "width", "height", "tileWidth", "tileHeight", "collisionGids", "layers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "tileWidth": { "type": "integer", "minimum": 1 },
    "tileHeight": { "type": "integer", "minimum": 1 },
    "collisionGids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "layers": { "type": "array" }
  }
}
