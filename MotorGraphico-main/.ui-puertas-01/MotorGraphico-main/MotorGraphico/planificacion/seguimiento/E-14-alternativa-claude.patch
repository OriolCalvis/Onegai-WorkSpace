+const char* PickerKindLabel(PickerKind kind) {
+    switch (kind) {
+        case PickerKind::Object:    return "objeto";
+        case PickerKind::Skill:     return "habilidad";
+        case PickerKind::Monster:   return "monstruo";
+        case PickerKind::Condition: return "estado";
+        case PickerKind::Map:       return "mapa";
+        case PickerKind::Event:     return "evento";
+    }
+    return "referencia";
+}
 
