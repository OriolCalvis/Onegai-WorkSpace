+// Palabras de la búsqueda ya plegadas. «Pocion  MAYOR» → {pocion, mayor}.
+std::vector<std::string> Palabras(const std::string& query) {
+    std::vector<std::string> palabras;
+    const std::string plegado = NormalizeForSearch(query);
+    std::string actual;
+    for (char c : plegado) {
+        if (c == ' ' || c == '\t') {
+            if (!actual.empty()) palabras.push_back(std::move(actual));
+            actual.clear();
+        } else {
+            actual += c;
+        }
+    }
+    if (!actual.empty()) palabras.push_back(std::move(actual));
+    return palabras;
+}
+
+bool Casa(const std::string& pajar, const std::vector<std::string>& palabras) {
+    for (const std::string& p : palabras) {
+        if (pajar.find(p) == std::string::npos) return false;
+    }
+    return true;
+}
+
+bool NecesitaAmbito(PickerKind kind) { return kind == PickerKind::Event; }
+
+// Para eventos el ámbito forma parte de la clave; para el resto se
+// ignora, así un selector de objetos abierto desde un mapa no deja de
+// ver los objetos del proyecto.
+bool MismoAmbito(PickerKind kind, const std::string& a, const std::string& b) {
+    return !NecesitaAmbito(kind) || a == b;
+}
+
+std::string Clave(PickerKind kind, const std::string& scope, const std::string& id) {
+    // El separador \x1f no puede salir de un id validado ni de un nombre
+    // de mapa: evita que («a», «b/c») y («a/b», «c») choquen.
+    return std::to_string(static_cast<int>(kind)) + '\x1f' +
+           (NecesitaAmbito(kind) ? scope : std::string()) + '\x1f' + id;
+}
+
+std::string Nombrado(const PickerEntry& e) {
+    std::string texto = std::string(PickerKindLabel(e.kind)) + " «" + e.id + "»";
+    if (!e.name.empty() && e.name != e.id) texto += " (" + e.name + ")";
+    return texto;
+}
