+MOTOR_TEST_CASE(referencia_perdida_localizable) {
+    MapDocument cueva = mapaCon(
+        "cueva",
+        {evento("cofre", "Cofre",
+                {cmd("inventario.dar", {{"objeto", "llave_oxidada"}}),
+                 cmd("inventario.dar", {{"objeto", "llave_perdida"}})},
+                2),
+         evento("salida", "Salida",
+                {cmd("interruptor.fijar", {{"evento", "cofre"}, {"letra", "A"}, {"valor", "true"}}),
+                 cmd("interruptor.fijar", {{"evento", "puerta_vieja"}, {"letra", "A"}, {"valor", "true"}}),
+                 cmd("mapa.ir", {{"mapa", "mapa_borrado"}})},
+                3),
+         evento("puerta", "Puerta", {cmd("mapa.ir", {{"mapa", "pueblo"}})}, 4)});
+
+    PickerIndex index;
+    anadir(index, entrada(PickerKind::Object, "llave_oxidada", "Llave oxidada"));
+    anadir(index, entrada(PickerKind::Map, "pueblo", "Pueblo"));
+    anadir(index, entrada(PickerKind::Map, "cueva", "Cueva"));
+    std::vector<std::string> problemas;
+    MOTOR_CHECK(AddEventsFromMap(index, cueva, "cueva.map.json", problemas) == 0);
+    MOTOR_CHECK(problemas.empty());
+    MOTOR_CHECK(index.count(PickerKind::Event) == 3);
+
+    // Exactamente las tres rotas, con su sitio. Las válidas no salen.
+    std::vector<LostReference> perdidas = FindLostReferences(cueva, index);
+    MOTOR_CHECK(perdidas.size() == 3);
+    std::map<std::string, const LostReference*> porId;
+    for (const LostReference& l : perdidas) porId[l.id] = &l;
+    MOTOR_CHECK(porId.count("llave_perdida") == 1);
+    MOTOR_CHECK(porId.count("mapa_borrado") == 1);
+    MOTOR_CHECK(porId.count("puerta_vieja") == 1);
+
+    const LostReference& llave = *porId["llave_perdida"];
+    MOTOR_CHECK(llave.kind == PickerKind::Object);
+    MOTOR_CHECK(llave.where.mapId == "cueva");
+    MOTOR_CHECK(llave.where.eventId == "cofre");
+    MOTOR_CHECK(llave.where.hasPage && llave.where.pageId == "cofre_p1");
+    MOTOR_CHECK(llave.where.hasCommand);
+    MOTOR_CHECK(llave.where.commandPath == std::vector<std::size_t>{1});
+    MOTOR_CHECK(llave.where.commandType == "inventario.dar");
+    MOTOR_CHECK(contiene(llave.message, "llave_perdida"));
+
+    const LostReference& mapa = *porId["mapa_borrado"];
+    MOTOR_CHECK(mapa.kind == PickerKind::Map);
+    MOTOR_CHECK(mapa.where.eventId == "salida");
+    MOTOR_CHECK(mapa.where.commandPath == std::vector<std::size_t>{2});
+
+    const LostReference& evento_roto = *porId["puerta_vieja"];
+    MOTOR_CHECK(evento_roto.kind == PickerKind::Event);
+    MOTOR_CHECK(evento_roto.where.commandPath == std::vector<std::size_t>{1});
+
+    // «Ir ahí» con el sitio devuelto lleva al comando exacto.
+    for (const LostReference& l : perdidas) {
+        NavigationRequest nav = ResolveNavigation(cueva, l.where);
+        if (!nav.ok()) MOTOR_CHECK_FAIL("no navega a " + l.id + ": " + nav.note);
+    }
+
+    // Abrir el selector sobre el valor roto: se marca, se conserva y no
+    // se sustituye por la primera fila.
+    CatalogPickerState picker(PickerKind::Object);
+    ReferenceCheck check = picker.open(index, "llave_perdida");
+    MOTOR_CHECK(check.state == ReferenceState::Missing);
+    MOTOR_CHECK(picker.hasLost());
+    MOTOR_CHECK(picker.lostId() == "llave_perdida");
+    MOTOR_CHECK(contiene(picker.lostMessage(), "llave_perdida"));
+    MOTOR_CHECK(picker.selectedId().empty());
+    MOTOR_CHECK(!picker.selectedRow().has_value());
+    Result<std::string> sinElegir = picker.accept(index);
+    MOTOR_CHECK(!sinElegir.isOk());
+    MOTOR_CHECK(contiene(sinElegir.errorMessage(), "llave_perdida"));
+
+    // El autor elige la buena: ya se puede aceptar.
+    MOTOR_CHECK(picker.select("llave_oxidada").isOk());
+    MOTOR_CHECK(picker.accept(index).value() == "llave_oxidada");
+
+    // Arreglado el documento, la lista queda vacía para ese id.
+    anadir(index, entrada(PickerKind::Object, "llave_perdida", "Llave perdida"));
+    perdidas = FindLostReferences(cueva, index);
+    MOTOR_CHECK(perdidas.size() == 2);
+    for (const LostReference& l : perdidas) MOTOR_CHECK(l.id != "llave_perdida");
+}
