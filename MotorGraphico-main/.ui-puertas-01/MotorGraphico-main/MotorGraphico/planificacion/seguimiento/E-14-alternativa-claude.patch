+    // típico de copiar un comando entre mapas.
+    std::vector<const PickerEntry*> otros = index.findAnyKind(id);
+    for (const PickerEntry* o : otros) {
+        if (o->kind == expected && NecesitaAmbito(expected)) {
+            check.state = ReferenceState::WrongKind;
+            check.message = Nombrado(*o) + " es del mapa «" + o->scope + "», no de «" + scope + "»";
+            return check;
+        }
+    }
+    if (!otros.empty()) {
+        check.state = ReferenceState::WrongKind;
+        check.message = "«" + id + "» es " + Nombrado(*otros.front()) + "; aquí se espera un " +
+                        PickerKindLabel(expected);
+        return check;
+    }
+    check.state = ReferenceState::Missing;
+    check.message = std::string("no existe ningún ") + PickerKindLabel(expected) + " «" + id + "»";
