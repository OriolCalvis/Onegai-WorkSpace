+// Adaptadores. Plantillas para no atar el selector a motor_level ni a
+// motor_rpg: cualquier catálogo con `ids()`+`find()` (ObjectCatalog) o
+// con `forEach()` (RPG::Catalogs::Catalog<T>) sirve. Devuelven cuántas
+// entradas se rechazaron y dejan los motivos en `problems`.
+template <typename IdCatalog, typename CategoryFn>
+std::size_t AddFromIdCatalog(PickerIndex& index, PickerKind kind, const IdCatalog& catalog,
+                             PickerOrigin origin, const std::string& source,
+                             CategoryFn categoryOf, std::vector<std::string>& problems) {
+    std::size_t rechazadas = 0;
+    for (const std::string& id : catalog.ids()) {
+        const auto* def = catalog.find(id);
+        if (def == nullptr) continue;
+        PickerEntry e;
+        e.kind = kind;
+        e.id = def->id;
+        e.name = def->name;
+        e.category = categoryOf(*def);
+        e.origin = origin;
+        e.source = source;
+        Result<bool> r = index.add(std::move(e));
+        if (!r.isOk()) {
+            ++rechazadas;
+            problems.push_back(r.errorMessage());
+        }
+    }
+    return rechazadas;
+}
