+MOTOR_TEST_CASE(filtro_entre_mil_entradas) {
+    PickerIndex index;
+    for (int i = 0; i < 1000; ++i) {
+        char id[32];
+        char nombre[32];
+        std::snprintf(id, sizeof id, "obj_%04d", i);
+        std::snprintf(nombre, sizeof nombre, "Objeto %04d", i);
+        anadir(index, entrada(PickerKind::Object, id, nombre, PickerOrigin::Project,
+                              i % 2 == 0 ? "arma" : "consumible"));
+    }
+    anadir(index, entrada(PickerKind::Object, "espada_hielo", "Espada de Hielo Élfica",
+                          PickerOrigin::Imported, "arma"));
+    MOTOR_CHECK(index.size() == 1001);
+
+    CatalogPickerState picker(PickerKind::Object);
+    picker.open(index, "");
+    MOTOR_CHECK(picker.rows().size() == 1001);
+    MOTOR_CHECK(picker.totalCount() == 1001);
+
+    // Por ID.
+    picker.setQuery("obj_0999");
+    MOTOR_CHECK(picker.rows().size() == 1);
+    MOTOR_CHECK(picker.rows()[0].id == "obj_0999");
+
+    // Por nombre, con varias palabras: TODAS tienen que estar, en
+    // cualquier sitio. El oráculo es la definición a mano, fila a fila:
+    // «09» también casa con 0090..0099 y con x09.
+    const auto oraculo = [](bool soloImpares) {
+        std::size_t n = 0;
+        for (int i = 0; i < 1000; ++i) {
+            char num[8];
+            std::snprintf(num, sizeof num, "%04d", i);
+            if (std::string(num).find("09") == std::string::npos) continue;
+            if (soloImpares && i % 2 == 0) continue;
+            ++n;
+        }
+        return n;
+    };
+    picker.setQuery("objeto 09");
+    MOTOR_CHECK(oraculo(false) == 119);
+    MOTOR_CHECK(picker.rows().size() == oraculo(false));
+    for (const PickerRow& r : picker.rows()) MOTOR_CHECK(contiene(r.id, "09"));
+    picker.setQuery("objeto 09 consumible");
+    MOTOR_CHECK(picker.rows().size() == oraculo(true));
+    for (const PickerRow& r : picker.rows()) MOTOR_CHECK(r.category == "consumible");
+    // El orden es el de la lista completa: por nombre.
+    for (std::size_t i = 1; i < picker.rows().size(); ++i) {
+        MOTOR_CHECK(picker.rows()[i - 1].label < picker.rows()[i].label);
+    }
+
+    // Mayúsculas y acentos plegados en los dos lados.
+    picker.setQuery("  ELFICA   hielo ");
+    MOTOR_CHECK(picker.rows().size() == 1);
+    MOTOR_CHECK(picker.rows()[0].id == "espada_hielo");
+    picker.setQuery("élfica");
+    MOTOR_CHECK(picker.rows().size() == 1);
+
+    // Sin coincidencias: lista vacía, no «todo».
+    picker.setQuery("dragon");
+    MOTOR_CHECK(picker.rows().empty());
+    MOTOR_CHECK(picker.totalCount() == 1001);
+
+    // Filtro por origen combinado con la búsqueda.
+    picker.setQuery("arma");
+    MOTOR_CHECK(picker.rows().size() == 501);
+    picker.setOriginFilter(OriginFilter::ImportedOnly);
+    MOTOR_CHECK(picker.rows().size() == 1);
+    picker.setOriginFilter(OriginFilter::ProjectOnly);
+    MOTOR_CHECK(picker.rows().size() == 500);
+    picker.setOriginFilter(OriginFilter::All);
+
+    // La selección es por identidad: sobrevive a un filtro que la oculta
+    // y reaparece en su sitio al quitarlo.
+    picker.setQuery("");
+    MOTOR_CHECK(picker.select("obj_0500").isOk());
+    picker.setQuery("hielo");
+    MOTOR_CHECK(!picker.selectedRow().has_value());
+    MOTOR_CHECK(picker.selectedId() == "obj_0500");
+    MOTOR_CHECK(picker.accept(index).isOk());
+    picker.setQuery("");
+    MOTOR_CHECK(picker.selectedRow().has_value());
+    MOTOR_CHECK(picker.rows()[*picker.selectedRow()].id == "obj_0500");
+
+    // Mil pulsaciones sobre mil entradas: el plegado va precalculado. No
+    // se mide tiempo (sería frágil en CI); se comprueba el resultado de
+    // una ráfaga que con un filtro mal hecho acabaría en otra lista.
+    const std::string teclas = "objeto 0123";
+    std::string escrito;
+    for (int vuelta = 0; vuelta < 90; ++vuelta) {
+        escrito.clear();
+        for (char c : teclas) {
+            escrito += c;
+            picker.setQuery(escrito);
+        }
+    }
+    MOTOR_CHECK(picker.rows().size() == 1);
+    MOTOR_CHECK(picker.rows()[0].id == "obj_0123");
+}
