+MOTOR_TEST_CASE(refresco_conserva_la_seleccion_y_detecta_la_borrada) {
+    PickerIndex antes;
+    anadir(antes, entrada(PickerKind::Skill, "curar", "Curar"));
+    anadir(antes, entrada(PickerKind::Skill, "bola_fuego", "Bola de fuego"));
+
+    CatalogPickerState picker(PickerKind::Skill);
+    picker.open(antes, "");
+    MOTOR_CHECK(picker.select("curar").isOk());
+
+    // El catálogo se recarga con una entrada nueva que cae DELANTE: la
+    // fila de «Curar» cambia de número, la selección no.
+    PickerIndex despues;
+    anadir(despues, entrada(PickerKind::Skill, "armadura", "Armadura arcana"));
+    anadir(despues, entrada(PickerKind::Skill, "curar", "Curar"));
+    anadir(despues, entrada(PickerKind::Skill, "bola_fuego", "Bola de fuego"));
+    picker.refresh(despues);
+    MOTOR_CHECK(picker.selectedId() == "curar");
+    MOTOR_CHECK(picker.rows()[*picker.selectedRow()].label == "Curar");
+    MOTOR_CHECK(!picker.hasLost());
+
+    // Y ahora la borran: la selección pasa a perdida, no a la vecina.
+    PickerIndex sinCurar;
+    anadir(sinCurar, entrada(PickerKind::Skill, "armadura", "Armadura arcana"));
+    anadir(sinCurar, entrada(PickerKind::Skill, "bola_fuego", "Bola de fuego"));
+    picker.refresh(sinCurar);
+    MOTOR_CHECK(picker.selectedId().empty());
+    MOTOR_CHECK(picker.hasLost());
+    MOTOR_CHECK(picker.lostId() == "curar");
+    MOTOR_CHECK(!picker.accept(sinCurar).isOk());
+
+    // Un accept con un índice más nuevo que el de la lista tampoco pasa
+    // un id que ya no está.
+    CatalogPickerState viejo(PickerKind::Skill);
+    viejo.open(antes, "bola_fuego");
+    PickerIndex vacio;
+    MOTOR_CHECK(!viejo.accept(vacio).isOk());
+}
