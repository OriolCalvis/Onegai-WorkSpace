{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "location_level2.schema.json",
  "title": "EGAROTH 2000bf NIVEL 2 LocationDefinition",
  "description": "Schema compatible con assets/catalogs/locations.json de MotorGraphico + campos NIVEL 2 lore obligatorios. Usado por las 4 IAs.",
  "type": "object",
  "properties": {
    "_mapa": {
      "description": "Bloque informativo. OPCIONAL en los ficheros de cada IA; el ensamblador final lo añadirá.",
      "type": "object"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/LocationDefinition" }
    }
  },
  "anyOf": [
    { "required": ["entries"] },
    { "$ref": "#/$defs/LocationDefinition" }
  ],
  "$defs": {
    "Coord": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "y": { "type": "integer", "minimum": 0, "maximum": 9999 }
      },
      "additionalProperties": false
    },
    "TierRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "PNJ": {
      "type": "object",
      "required": ["name", "role", "hook"],
      "properties": {
        "name":     { "type": "string", "minLength": 2 },
        "raceId":   { "type": "string", "description": "De race_*  en Catalogs/RaceCatalog (43 existentes). Campo RECOMENDADO." },
        "classId":  { "type": "string", "description": "De class_* en Catalogs/ClassCatalog (61 existentes). Campo RECOMENDADO." },
        "role":     { "type": "string", "minLength": 3, "description": "gobernador / capitan gremio / sacerdote / contrabandista …" },
        "tier":     { "type": "integer", "minimum": 1, "maximum": 5 },
        "hook":     { "type": "string", "minLength": 10, "description": "1 frase, por qué interactúa con el jugador / cuál es su secreto." }
      },
      "additionalProperties": false
    },
    "Quest": {
      "type": "object",
      "required": ["id", "title", "hook"],
      "properties": {
        "id":     { "type": "string", "pattern": "^quest_[a-z_0-9]+$" },
        "title":  { "type": "string", "minLength": 3 },
        "tier":   { "type": "integer", "minimum": 1, "maximum": 5 },
        "hook":   { "type": "string", "minLength": 15, "description": "Situación de partida: que pide, por qué, que pasa si falla." }
      },
      "additionalProperties": false
    },
    "Faction": {
      "type": "object",
      "required": ["id", "name", "role"],
      "properties": {
        "id":     { "type": "string", "pattern": "^faction_[a-z_0-9]+$" },
        "name":   { "type": "string", "minLength": 3 },
        "role":   { "type": "string", "minLength": 5, "description": "nobleza / ejército / iglesia / gremio / clan / contrabandistas / magos …" },
        "leader": { "type": "string" },
        "alignmentId": { "type": "string", "description": "alignment_* (5 existentes: lawful_good, neutral_good, chaotic_good, lawful_evil, neutral, chaotic_evil, true_neutral …)" }
      },
      "additionalProperties": false
    },
    "Dungeon": {
      "type": "object",
      "required": ["id", "name", "tier", "theme"],
      "properties": {
        "id":    { "type": "string", "pattern": "^dungeon_[a-z_0-9]+$" },
        "name":  { "type": "string", "minLength": 3 },
        "tier":  { "type": "integer", "minimum": 1, "maximum": 5 },
        "theme": { "type": "string", "minLength": 5, "description": "cueva de krakens / cementerio no-muerto / ruinas pre-eras / fortaleza caída / torre maga …" },
        "coord": { "$ref": "#/$defs/Coord" },
        "bossMonsterId": { "type": "string", "description": "De monster_* en MonsterCatalog (432 existentes). Recomendado." },
        "relicIds": { "type": "array", "items": { "type": "string" }, "description": "IDs de reliquias en 20_catalogo_objetos_unicos.json (opcional)." }
      },
      "additionalProperties": false
    },
    "EraXIIIEvent": {
      "type": "object",
      "required": ["id", "year", "title"],
      "properties": {
        "id":       { "type": "string", "pattern": "^era13_ev_[a-z_0-9]+$" },
        "year":     { "type": "integer", "minimum": 2000, "maximum": 1990, "description": "2000 = inicio ERA XIII, 1990 = 10 años Cruzadas. NO pasar de 1990." },
        "title":    { "type": "string", "minLength": 5 },
        "summary":  { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },

    "LocationDefinitionCommon": {
      "type": "object",
      "required": ["id", "locationType", "name"],
      "properties": {
        "id":       { "type": "string", "minLength": 3, "pattern": "^(nation|city|zone)_" },
        "locationType": { "enum": ["nation", "city", "zone"] },
        "name":     { "type": "string", "minLength": 2 },
        "alignment":{ "type": ["string", "null"] },
        "color":    { "type": ["string", "null"], "pattern": "^#[0-9a-f]{6}$" },
        "culture":  { "type": ["string", "null"] },
        "deityIds": { "type": "array", "items": { "type": "string" } },
        "raceIds":  { "type": "array", "items": { "type": "string" } },
        "rarity":   { "enum": ["common","uncommon","rare","epic","legendary"] },
        "tier":     { "type": "integer", "minimum": 0, "maximum": 5 },

        "origin":   { "type": "string", "enum": ["ATLAS_CANON","CLOUDE","TRAE","ZCODE","CHATGPT"], "description": "ATLAS_CANON si ya existía en el locations.json original. Nombre IA si la creó esta IA (era Aldea IX / etc)." },
        "position": { "$ref": "#/$defs/Coord", "description": "RECOMENDADO: posición en pixels SVG del Atlas. Si no lo sabes, déjalo sin position." },
        "coord":    { "$ref": "#/$defs/Coord", "description": "Coordenada lógica en rejilla 0..200 x 0..150. OBLIGATORIA para ciudades y mazmorras." },

        "metadata": {
          "description": "Campo libre NIVEL 2. Todo lore extra va AQUÍ, nunca en el root, para no romper loaders del motor.",
          "type": "object"
        }
      },
      "additionalProperties": true
    },

    "NationDefinition": {
      "allOf": [
        { "$ref": "#/$defs/LocationDefinitionCommon" },
        {
          "type": "object",
          "required": ["capitalId", "metadata"],
          "properties": {
            "locationType": { "const": "nation" },
            "capitalId": { "type": "string", "description": "id de la ciudad capital (city_*)" },
            "polygon":   { "type": ["string", "null"], "description": "x1,y1 x2,y2 ... ASCII SVG polygon (del Atlas canon si existe)." },
            "metadata": {
              "type": "object",
              "required": ["gobierno", "biomaGeneral", "tierRange", "eraXIIIEvents", "factions", "dungeons", "lore"],
              "properties": {
                "gobierno":       { "type": "string", "minLength": 3 },
                "biomaGeneral":   { "type": "string", "minLength": 3 },
                "tierRange":      { "$ref": "#/$defs/TierRange" },
                "regions":        { "type": "array", "items": { "type": "string" } },
                "eraXIIIEvents":  { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EraXIIIEvent" } },
                "factions":       { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/Faction" } },
                "dungeons":       { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Dungeon" } },
                "lore":           { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string", "minLength": 30 } }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },

    "CityDefinition": {
      "allOf": [
        { "$ref": "#/$defs/LocationDefinitionCommon" },
        {
          "type": "object",
          "required": ["nationId", "position", "coord", "metadata"],
          "properties": {
            "locationType": { "const": "city" },
            "nationId": { "type": "string", "pattern": "^nation_" },
            "controlledBy":   { "type": ["string", "null"], "description": "Nombre legible de la nación que la controla HOY (2000bf). Puede ser igual a nationId pero con nombre legible." },
            "pendingCanonName": { "type": "boolean", "default": false },
            "settlementSize": { "enum": ["aldea","pueblo","ciudad","capital","fortaleza","puerto","mina"], "description": "Aldea <1k, Pueblo 1-3k, Ciudad 3-10k, Capital 10k+." },
            "population": { "type": "string", "pattern": "^~[0-9][0-9.]*$", "examples": ["~300","~1.500","~8.000","~25.000"] },
            "ruler":      { "type": ["string","null"] },
            "trait":      { "type": ["string","null"], "description": "Rasgo distintivo 1-3 palabras: puerto de contrabando / pozo que susurra / feria famosa / santuario …" },
            "npcIds":     { "type": "array", "items": { "type": "string" } },
            "storyIds":   { "type": "array", "items": { "type": "string" } },

            "metadata": {
              "type": "object",
              "required": ["primaryActivity", "faction", "tierRange", "pnjPrincipal", "quests"],
              "properties": {
                "primaryActivity": { "type": "string", "minLength": 3, "examples": ["minería","pesca","puerto","plaza fuerte","agricultura","santuario","universidad","feria anual","contrabando"] },
                "faction":         { "type": "string", "pattern": "^faction_" },
                "tierRange":       { "$ref": "#/$defs/TierRange" },
                "pnjPrincipal":    { "$ref": "#/$defs/PNJ" },
                "quests":          { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Quest" } }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },

    "ZoneDefinition": {
      "allOf": [
        { "$ref": "#/$defs/LocationDefinitionCommon" },
        {
          "type": "object",
          "required": ["nationId", "coord", "metadata"],
          "properties": {
            "locationType": { "const": "zone" },
            "nationId":  { "type": "string", "pattern": "^nation_" },
            "metadata": {
              "type": "object",
              "required": ["kind", "dungeons"],
              "properties": {
                "kind":     { "enum": ["mazmorras","frontera militar","valle maldito","bosque antiguo","cordillera","mar interior","isla","desierto"] },
                "tierRange":{ "$ref": "#/$defs/TierRange" },
                "dungeons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Dungeon" } }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },

    "LocationDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/NationDefinition" },
        { "$ref": "#/$defs/CityDefinition" },
        { "$ref": "#/$defs/ZoneDefinition" }
      ]
    }
  }
}
