+// ===== CAPTURAS (parche local, NO forma parte del repo) =====
+// Pausa, Opciones y Game Over se crean pero nunca se registran en el HUD:
+// hoy no se dibujan. Para fotografiar como quedarian con SUS widgets se
+// registran aqui y se encienden segun el modo en refreshHud().
+void Application::capturasRegistrarPantallas() {
+    if (!m_pauseMenuWidget || !m_gameOverMenuWidget) return;
+    const auto opciones = Game::OptionsState::create().displayLines();
+    const Vector2 size = HudCommandMenu::contentSize(*m_font, opciones);
+    HudTransform menuT; menuT.anchor = HudAnchor::Center; menuT.size = {size.x + 48.0f, size.y};
+    m_capOptionsMenu = std::make_unique<HudCommandMenu>(menuT, m_font.get(), opciones);
+    HudTransform panelT; panelT.anchor = HudAnchor::Center;
+    panelT.size = {menuT.size.x + 2.0f * kMenuPadding, menuT.size.y + 2.0f * kMenuPadding};
+    m_capOptionsPanel = std::make_unique<HudPanel>(panelT, m_whiteTexture.get(), kPanelColor);
+    m_capOptionsPanel->setBorder(kBorderColor, 2.0f);
+    for (IHudElement* w : {static_cast<IHudElement*>(m_pauseMenuPanel.get()),
+                           static_cast<IHudElement*>(m_pauseMenuWidget.get()),
+                           static_cast<IHudElement*>(m_capOptionsPanel.get()),
+                           static_cast<IHudElement*>(m_capOptionsMenu.get()),
+                           static_cast<IHudElement*>(m_pauseMenuHint.get()),
+                           static_cast<IHudElement*>(m_gameOverScreenPanel.get()),
+                           static_cast<IHudElement*>(m_gameOverScreenTitle.get()),
+                           static_cast<IHudElement*>(m_gameOverMenuWidget.get()),
+                           static_cast<IHudElement*>(m_gameOverScreenHint.get())}) {
+        w->setVisible(false);
+        m_hud.addElement(w);
+    }
+}
+
+void Application::capturasVisibilidadPantallas() {
+    static const bool comoHoy = std::getenv("CAPTURAS_COMO_HOY") != nullptr;
+    if (comoHoy) return;  // se quedan ocultas, como en el codigo real
+    if (!m_pauseMenuWidget || !m_capOptionsMenu || !m_session) return;
+    const bool pausa = m_session->mode() == GameMode::Pause;
+    const bool opciones = pausa && m_options != nullptr;
+    if (opciones) {
+        m_capOptionsMenu->setOptions(m_options->displayLines());
+        m_capOptionsMenu->setSelectedIndex(m_options->selected());
+    }
+    m_pauseMenuPanel->setVisible(pausa && !opciones);
+    m_pauseMenuWidget->setVisible(pausa && !opciones);
+    m_capOptionsPanel->setVisible(opciones);
+    m_capOptionsMenu->setVisible(opciones);
+    m_pauseMenuHint->setVisible(pausa);
+    const bool fin = m_session->mode() == GameMode::GameOver;
+    m_gameOverScreenPanel->setVisible(fin);
+    m_gameOverScreenTitle->setVisible(fin);
+    m_gameOverMenuWidget->setVisible(fin);
+    m_gameOverScreenHint->setVisible(fin);
+}
