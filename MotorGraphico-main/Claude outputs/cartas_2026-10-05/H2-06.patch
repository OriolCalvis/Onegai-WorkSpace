+
+// --- H2-06: el menu de combate con las cartas del heroe, y en el cuadro del
+// combate, lo que hace la carta marcada. Lo que se decide (que cartas hay,
+// cuales se pueden jugar y por que no) vive en Game::CartasEnCombate, sin GL;
+// aqui solo se pinta. ---
+
+void Application::menuDeCartas(const BattleState& batalla) {
+    std::vector<std::string> opciones{"Atacar", "Pocion", "Huir"};
+    if (const Game::IMesaCombate* mesa = batalla.mesa()) {
+        for (std::string& fila : mesa->filas()) opciones.push_back(std::move(fila));
+    }
+    if (opciones != m_commandMenu->options()) m_commandMenu->setOptions(opciones);
+    // El menu crece hacia arriba (anclado abajo a la izquierda) y su panel con
+    // el. Si los nombres de carta lo meten bajo el cuadro del combate, sube por
+    // encima: si no, le tapa el principio de las lineas (y el detalle).
+    HudTransform menu = m_commandMenu->transform();
+    menu.size = HudCommandMenu::contentSize(*m_font, opciones);
+    const HudTransform& cuadro = m_dialoguePanel->transform();
+    const float bordeCuadro = 0.5f * (static_cast<float>(m_width) - cuadro.size.x);
+    const bool tapa = menu.offset.x + menu.size.x + kMenuPadding > bordeCuadro;
+    menu.offset.y = tapa ? cuadro.offset.y + cuadro.size.y + 8.0f + kMenuPadding : kMenuCombateY;
+    m_commandMenu->setTransform(menu);
+    m_commandPanel->setTransform({menu.anchor, {menu.offset.x - kMenuPadding, menu.offset.y - kMenuPadding},
+                                  {menu.size.x + 2.0f * kMenuPadding, menu.size.y + 2.0f * kMenuPadding}});
+}
+
+std::vector<std::string> Application::lineasDeCombate(const BattleState& batalla) const {
+    // El cuadro del combate mide 640 y no envuelve: sus lineas se parten aqui.
+    constexpr int kAncho = 600;
+    std::vector<std::string> lineas;
+    const auto anade = [&](const std::string& texto) {
+        for (std::string& l : BitmapFont::wrapText(texto, kAncho, m_font->glyphWidth())) {
+            lineas.push_back(std::move(l));
+        }
+    };
+    for (const std::string& l : batalla.log()) anade(l);
+    const std::size_t fila = m_commandMenu->selectedIndex();
+    const Game::IMesaCombate* mesa = batalla.mesa();
+    if (mesa != nullptr && fila >= 3) {
+        const std::string detalle = mesa->detalle(fila - 3);
+        if (!detalle.empty()) anade("> " + detalle);
+    }
+    return lineas;
+}
