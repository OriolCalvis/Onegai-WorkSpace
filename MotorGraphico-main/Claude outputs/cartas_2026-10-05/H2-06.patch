diff --git a/tests/Game/CartasEnCombateTests.cpp b/tests/Game/CartasEnCombateTests.cpp
new file mode 100644
index 0000000..9eb1003
--- /dev/null
+++ b/tests/Game/CartasEnCombateTests.cpp
@@ -0,0 +1,208 @@
+// H2-06 — Las cartas de las cuatro clases hacen en combate lo que dice su
+// texto (Game::CartasEnCombate sobre BattleState).
+//
+// Los catalogos son los reales (assets/catalogs): la carta publicada con sus
+// ganchos. El dado es fijo, todas las caras iguales, y las cuentas se pueden
+// hacer a mano (Ed. 3: 6 = 1 exito, 5 = medio; con ventaja el 4 tambien vale
+// medio; con desventaja solo cuenta el 6):
+//   heroe  CON 2, DES 5 -> ataca con 6 dados, defiende con 5;
+//   lobo   CON 1, DES 4 -> ataca con 5 dados, defiende con 4; 60 PV.
+// Con el dado en 5: el heroe acierta (3 contra 2) = 10 de golpe de arma; el
+// lobo empata (2,5 contra 2,5) = parcial, 5 de dano.
+#include "CartasPrueba.h"
+#include "RPG/CharacterCreation.h"
+#include "TestHarness.h"
+
+#include <string>
+
+MOTOR_TEST_CASE(los_ganchos_publicados_se_entienden_todos) {
+    // Ningun gancho de cartas, pasivas o condiciones queda «desconocido»:
+    // si alguien escribe uno nuevo sin ensenarselo al motor, falla aqui.
+    RPG::Catalogs::SkillCatalog skills;
+    RPG::Catalogs::PassiveCatalog pasivas;
+    RPG::Catalogs::ConditionCatalog condiciones;
+    MOTOR_CHECK(skills.loadFromFile("assets/catalogs/skills.json").isOk());
+    MOTOR_CHECK(pasivas.loadFromFile("assets/catalogs/passives.json").isOk());
+    MOTOR_CHECK(condiciones.loadFromFile("assets/catalogs/conditions.json").isOk());
+    int ganchos = 0;
+    const auto revisa = [&](const std::vector<std::string>& crudos) {
+        for (const Game::Gancho& g : Game::leerGanchos(crudos)) {
+            ++ganchos;
+            MOTOR_CHECK(g.tipo != T::Desconocido);
+        }
+    };
+    skills.forEach([&](const RPG::SkillDefinition& d) { revisa(d.mechanicHooks); });
+    pasivas.forEach([&](const RPG::PassiveDefinition& d) { revisa(d.mechanicHooks); });
+    condiciones.forEach([&](const RPG::ConditionDefinition& d) { revisa(d.mechanicHooks); });
+    MOTOR_CHECK(ganchos > 60);
+}
+
+MOTOR_TEST_CASE(las_cuarenta_cartas_tienen_ganchos_y_solo_lo_pendiente_se_bloquea) {
+    const char* const clasesConCombate[] = {"bardo_de_las_cuatro_estaciones", "el_apostata",
+                                            "senor_de_las_armas", "furia_de_los_creadores"};
+    int bloqueadas = 0;
+    for (const char* id : clasesConCombate) {
+        for (const std::string& s : clases().find(id)->learnableSkillIds) {
+            const Game::CatalogoCartas::Carta* c = catalogo().carta(s);
+            MOTOR_CHECK(c != nullptr && !c->ganchos.empty());
+            if (!c->bloqueo.empty()) ++bloqueadas;
+        }
+    }
+    // Las dos que faltan del Senor de las Armas, Susurro Demoniaco y Ataque
+    // Maldito ([pendiente]) y Paso Ilusorio (necesita posiciones).
+    MOTOR_CHECK(bloqueadas == 5);
+    MOTOR_CHECK(catalogo().carta("paso_ilusorio")->bloqueo == "necesita posiciones en el combate");
+    // La pasiva del Bardo da a elegir entre cuatro estaciones.
+    int opciones = 0;
+    for (const Game::Gancho& g : catalogo().ganchosDePasiva("las_cuatro_estaciones")) {
+        if (g.tipo == T::EligeUna) opciones = static_cast<int>(g.opciones.size());
+    }
+    MOTOR_CHECK(opciones == 4);
+}
+
+MOTOR_TEST_CASE(la_ficha_creada_conoce_todas_las_cartas_de_su_clase) {
+    auto creacion = RPG::CharacterCreation::load("assets/catalogs");
+    MOTOR_CHECK(creacion.isOk());
+    RPG::CreationChoice e;
+    e.displayName = "Ilse";
+    e.raceId = "elfos_del_bosque";
+    e.classId = "bardo_de_las_cuatro_estaciones";
+    // Primer trasfondo con opciones, como haria la pantalla.
+    creacion.value().backgrounds().forEach([&](const RPG::BackgroundDefinition& b) {
+        if (e.backgroundId.empty() && creacion.value().opcionesDe(b.id) != nullptr) e.backgroundId = b.id;
+    });
+    const auto* op = creacion.value().opcionesDe(e.backgroundId);
+    MOTOR_CHECK(op != nullptr);
+    e.bondId = op->bonds.front().id;
+    e.fearId = op->fears.front().id;
+    e.flawId = op->flaws.front().id;
+    e.goalId = op->goals.front().id;
+    e.idealId = op->ideals.front().id;
+    e.personalityId = op->personalities.front().id;
+    e.virtueId = op->virtues.front().id;
+    e.baseStats = {4, 4, 4, 4};
+    auto ficha = creacion.value().construir(e);
+    MOTOR_CHECK(ficha.isOk());
+    for (const std::string& id : clases().find(e.classId)->learnableSkillIds) {
+        bool la = false;
+        for (const std::string& k : ficha.value().knownSkillIds) la |= k == id;
+        MOTOR_CHECK(la);
+    }
+}
+
+MOTOR_TEST_CASE(sin_ficha_no_hay_mesa_y_el_combate_es_el_de_siempre) {
+    Luchador sinFicha{30, 2, 5};
+    MOTOR_CHECK(Game::CartasEnCombate::paraHeroe(catalogo(), sinFicha) == nullptr);
+}
+
+MOTOR_TEST_CASE(bardo_cancion_del_otono_da_desventaja_dos_turnos) {
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    MOTOR_CHECK(m.jugar("Cancion del Otono"));
+    MOTOR_CHECK(m.carta("cancion_del_otono").gastada);
+    m.ronda();  // el lobo tira con desventaja: sus 5 no cuentan, 0 contra 2,5
+    MOTOR_CHECK(m.heroe.health() == 30);
+    m.atacar();
+    m.ronda();
+    MOTOR_CHECK(m.heroe.health() == 30);
+    m.atacar();
+    m.ronda();  // la cancion se acabo: empate, parcial
+    MOTOR_CHECK(m.heroe.health() == 25);
+}
+
+MOTOR_TEST_CASE(bardo_cancion_del_invierno_deja_fuera_de_combate_dos_turnos) {
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    MOTOR_CHECK(m.jugar("Cancion del Invierno"));
+    m.ronda();
+    MOTOR_CHECK(m.heroe.health() == 30);
+    m.atacar();  // defensa del lobo con desventaja: 0 contra 3
+    MOTOR_CHECK(m.lobo.health() == 50);
+    m.ronda();
+    MOTOR_CHECK(m.heroe.health() == 30);
+    m.atacar();
+    m.ronda();
+    MOTOR_CHECK(m.heroe.health() == 25);
+}
+
+MOTOR_TEST_CASE(bardo_verano_da_ventaja_en_ataque) {
+    Mesa sin("bardo_de_las_cuatro_estaciones");
+    sin.dado.cara = 4;
+    sin.atacar();  // 0 contra 0: parcial
+    MOTOR_CHECK(sin.lobo.health() == 55);
+
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    m.dado.cara = 4;
+    MOTOR_CHECK(m.fila("Elegir Primavera") == 0);
+    MOTOR_CHECK(m.jugar("Elegir Verano"));
+    MOTOR_CHECK(m.cartas->turnoAbierto());  // elegir no gasta la accion
+    MOTOR_CHECK(m.fila("Elegir") < 0);
+    m.atacar();  // con ventaja el 4 vale medio: 3 contra 0, exito
+    MOTOR_CHECK(m.lobo.health() == 50);
+}
+
+MOTOR_TEST_CASE(bardo_invierno_refleja_el_primer_turno_y_da_mas_defensa) {
+    Mesa m("bardo_de_las_cuatro_estaciones", 1, 8);  // lobo con DES 8: 9 dados
+    MOTOR_CHECK(m.jugar("Elegir Invierno"));
+    m.atacar();
+    m.ronda();  // 4,5 contra 3,5 (5 dados + 2 de CA): acierta, pero se refleja
+    MOTOR_CHECK(m.heroe.health() == 30);
+    MOTOR_CHECK(m.lobo.health() == 50);
+    m.atacar();
+    m.ronda();  // segundo turno: ya no refleja
+    MOTOR_CHECK(m.heroe.health() == 20);
+}
+
+MOTOR_TEST_CASE(bardo_invierno_suma_dos_dados_a_la_defensa_fisica) {
+    // Lobo normal: 2,5 contra 5 dados (2,5) seria parcial; con +2 de CA el
+    // heroe defiende con 7 (3,5) y el lobo falla los dos turnos.
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    MOTOR_CHECK(m.jugar("Elegir Invierno"));
+    m.atacar();
+    m.ronda();
+    m.atacar();
+    m.ronda();
+    MOTOR_CHECK(m.heroe.health() == 30);
+    MOTOR_CHECK(m.lobo.health() == 40);  // solo los dos golpes del heroe
+}
+
+MOTOR_TEST_CASE(un_enemigo_que_gana_la_tirada_resiste_la_cancion) {
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    m.dado.cara = 4;  // 0 contra 0: empate, parcial; el estado pide exito
+    MOTOR_CHECK(m.jugar("Cancion del Otono"));
+    MOTOR_CHECK(m.situLobo().estados.empty());
+    MOTOR_CHECK(m.carta("cancion_del_otono").gastada);  // la carta se juega igual
+}
+
+MOTOR_TEST_CASE(bardo_bendicion_de_las_estrellas_bloquea_un_ataque) {
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    MOTOR_CHECK(m.jugar("Bendicion de las Estrellas (reaccion)"));
+    MOTOR_CHECK(m.cartas->turnoAbierto());  // preparar no gasta la accion
+    MOTOR_CHECK(m.fila("Bendicion de las Estrellas (preparada)") >= 0);
+    m.atacar();
+    m.ronda();
+    MOTOR_CHECK(m.heroe.health() == 30);
+    MOTOR_CHECK(m.carta("bendicion_de_las_estrellas").gastada);
+    m.atacar();
+    m.ronda();
+    MOTOR_CHECK(m.heroe.health() == 25);
+}
+
+MOTOR_TEST_CASE(bardo_ola_de_elementos_devuelve_una_cancion_gastada) {
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    MOTOR_CHECK(m.fila("Ola de Elementos (no hay canciones gastadas)") >= 0);
+    MOTOR_CHECK(m.jugar("Cancion del Otono"));
+    m.ronda();
+    MOTOR_CHECK(m.jugar("Ola de Elementos: Cancion del Otono"));
+    MOTOR_CHECK(!m.carta("cancion_del_otono").gastada);
+    MOTOR_CHECK(m.carta("ola_de_elementos").gastada);
+    MOTOR_CHECK(m.cartas->turnoAbierto());  // accion libre
+}
+
+MOTOR_TEST_CASE(bardo_cancion_de_la_primavera_cura_y_primavera_suma_dos) {
+    Mesa m("bardo_de_las_cuatro_estaciones");
+    m.heroe.ponerVida(10);
+    MOTOR_CHECK(m.jugar("Elegir Primavera"));
+    MOTOR_CHECK(m.jugar("Cancion de la Primavera"));  // 1d6 = 5, exito, +2
+    MOTOR_CHECK(m.heroe.health() == 17);
+}
+
+int main() { return motor_test::runAllTests(); }
diff --git a/tests/Game/CartasPrueba.h b/tests/Game/CartasPrueba.h
new file mode 100644
index 0000000..573ee6c
--- /dev/null
+++ b/tests/Game/CartasPrueba.h
@@ -0,0 +1,140 @@
+// H2-06 — Lo comun a las pruebas de las cartas en combate: el dado fijo, el
+// luchador de prueba y la mesa (el heroe de una clase contra un lobo). Ver
+// las cuentas en tests/Game/CartasEnCombateTests.cpp.
+#pragma once
+
+#include "Game/BattleState.h"
+#include "Game/CartasEnCombate.h"
+#include "Game/CatalogoCartas.h"
+#include "Game/Skill.h"
+#include "RPG/CharacterSheet.h"
+#include "Render/ICombatant.h"
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace cartas_prueba {
+
+using T = Game::Gancho::Tipo;
+
+class DadoFijo : public RPG::RandomEngine {
+public:
+    explicit DadoFijo(int c) : cara(c) {}
+    int roll_d6() override { return cara; }
+    int roll_in_range(int a, int b) override { return cara < a ? a : (cara > b ? b : cara); }
+    uint64_t seed() const override { return 0; }
+    int cara;
+};
+
+class Luchador : public ICombatant {
+public:
+    Luchador(int vida, int con, int des) : m_vida(vida), m_max(vida), m_stats{con, des, 1, 3} {}
+    RPG::CharacterSheet* ficha = nullptr;
+    int nivel = 1;
+    RPG::CharacterSheet* character_sheet() override { return ficha; }
+    const RPG::CharacterSheet* character_sheet() const override { return ficha; }
+    void takeDamage(int n) override { m_vida = m_vida > n ? m_vida - n : 0; }
+    void heal(int n) override { m_vida = m_vida + n > m_max ? m_max : m_vida + n; }
+    int health() const override { return m_vida; }
+    int maxHealth() const override { return m_max; }
+    bool isAlive() const override { return m_vida > 0; }
+    int stat(RPG::Stat s) const override { return m_stats[static_cast<std::size_t>(s)]; }
+    RPG::DefenseBlock defenses() const override { return {}; }
+    int tier() const override { return nivel; }
+    std::string combatant_id() const override { return "luchador"; }
+    void ponerVida(int v) { m_vida = v; }
+
+private:
+    int m_vida;
+    int m_max;
+    std::array<int, 4> m_stats;
+};
+
+inline const Game::CatalogoCartas& catalogo() {
+    static const std::unique_ptr<Game::CatalogoCartas> c = [] {
+        auto r = Game::CatalogoCartas::cargar("assets/catalogs");
+        if (!r.isOk()) {
+            std::fprintf(stderr, "%s\n", r.errorMessage().c_str());
+            std::abort();
+        }
+        return std::move(r.value());
+    }();
+    return *c;
+}
+
+inline const RPG::Catalogs::ClassCatalog& clases() {
+    static RPG::Catalogs::ClassCatalog c;
+    if (c.size() == 0 && !c.loadFromFile("assets/catalogs/classes.json").isOk()) std::abort();
+    return c;
+}
+
+// Una batalla: el heroe de la clase (con todas sus cartas) contra un lobo.
+struct Mesa {
+    RPG::CharacterSheet ficha;
+    Luchador heroe{30, 2, 5};
+    Luchador lobo{60, 1, 4};
+    SkillCatalog legado;
+    DadoFijo dado{5};
+    std::unique_ptr<BattleState> batalla;
+    Game::CartasEnCombate* cartas = nullptr;
+
+    explicit Mesa(const char* clase, int tier = 1, int desLobo = 4) : lobo(60, 1, desLobo) {
+        const RPG::ClassDefinition* def = clases().find(clase);
+        ficha.knownSkillIds = def->startingSkillIds;
+        for (const std::string& id : def->learnableSkillIds) {
+            bool ya = false;
+            for (const std::string& k : ficha.knownSkillIds) ya |= k == id;
+            if (!ya) ficha.knownSkillIds.push_back(id);
+        }
+        ficha.passiveIds = {def->passiveId};
+        ficha.tier = tier;
+        heroe.ficha = &ficha;
+        heroe.nivel = tier;
+        batalla = std::make_unique<BattleState>(
+            std::vector<BattleParticipant>{{"Heroe", &heroe, nullptr, nullptr}},
+            std::vector<BattleParticipant>{{"Lobo", &lobo, nullptr, nullptr}}, &legado);
+        batalla->setRandomEngine(dado);
+        auto mesa = Game::CartasEnCombate::paraHeroe(catalogo(), heroe);
+        cartas = mesa.get();
+        batalla->setMesa(std::move(mesa));
+    }
+
+    int fila(const std::string& texto) const {
+        const auto filas = cartas->filas();
+        for (std::size_t i = 0; i < filas.size(); ++i) {
+            if (filas[i].compare(0, texto.size(), texto) == 0) return static_cast<int>(i);
+        }
+        return -1;
+    }
+    // Juega la fila que empieza por "texto". false si no esta o esta bloqueada.
+    bool jugar(const std::string& texto) {
+        const int i = fila(texto);
+        BattleAction a;
+        if (i < 0 || !cartas->accionDeFila(static_cast<std::size_t>(i), a)) return false;
+        batalla->resolveAllyAction(0, a);
+        return true;
+    }
+    void atacar() { batalla->resolveAllyAction(0, BattleAction{BattleActionType::Attack, "", 0, ""}); }
+    // Lo que hace Application tras la accion del heroe.
+    void ronda() {
+        if (cartas->turnoAbierto()) return;
+        batalla->resolveEnemyTurn();
+        batalla->tickRound();
+    }
+    const Game::CartaEnMano& carta(const std::string& id) const {
+        for (const Game::CartaEnMano& c : cartas->mano()) {
+            if (c.carta->def->id == id) return c;
+        }
+        std::abort();
+    }
+    const Game::SituacionCombate& situLobo() const { return *cartas->situacion(false, 0); }
+};
+
+}  // namespace cartas_prueba
