@@ -0,0 +1,77 @@
+// H2-06 — Piezas internas de Game::CartasEnCombate, compartidas por sus tres
+// .cpp (CartasEnCombate.cpp, CartasJugar.cpp y CartasTiradas.cpp). No es API.
+#pragma once
+
+#include <array>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "Game/BattleState.h"
+#include "Game/CartasEnCombate.h"
+#include "RPG/Defense.h"
+#include "RPG/DicePoolEngine.h"
+#include "Render/ICombatant.h"
+
+namespace Game {
+namespace cartas {
+
+// Una invocacion de carta (Invocacion Oscura): un combatiente sin ficha con
+// la vida y los stats de summons.json. Lucha en el bando del heroe.
+class Invocado : public ICombatant {
+public:
+    Invocado(std::string id, int vida, const std::array<int, 4>& stats)
+        : m_id(std::move(id)), m_vida(vida), m_max(vida), m_stats(stats) {}
+    void takeDamage(int cantidad) override { m_vida = m_vida > cantidad ? m_vida - cantidad : 0; }
+    void heal(int cantidad) override { m_vida = m_vida + cantidad > m_max ? m_max : m_vida + cantidad; }
+    int health() const override { return m_vida; }
+    int maxHealth() const override { return m_max; }
+    bool isAlive() const override { return m_vida > 0; }
+    int stat(RPG::Stat s) const override { return m_stats[static_cast<std::size_t>(s)]; }
+    RPG::DefenseBlock defenses() const override { return {}; }
+    int tier() const override { return 1; }
+    std::string combatant_id() const override { return m_id; }
+    void desvanecer() { m_vida = 0; }
+
+private:
+    std::string m_id;
+    int m_vida;
+    int m_max;
+    std::array<int, 4> m_stats;
+};
+
+// Un rasgo que pesa ahora sobre alguien, con quien lo puso (si se sabe):
+// «ventaja contra quien te marco», «provocado por», «+1d6 de quien te maldijo».
+struct RasgoActivo {
+    Gancho g;
+    bool conOrigen = false;
+    bool origenAliado = true;
+    std::size_t origen = 0;
+};
+
+// Resultado de una tirada enfrentada (o sin rival) de la mesa.
+struct Tirada {
+    RPG::Degree grado = RPG::Degree::BOTCH;
+    int magnitud = 0;     // la de la carta por grado (golpe de arma, habilidad legada)
+    std::string resumen;  // "Exito, 2 contra 1"
+};
+
+const char* gradoTexto(RPG::Degree g);
+// Dano o cura de una carta por grado: fallo 0, parcial la mitad (minimo 1),
+// exito entero, critico x1,5 (mismo reparto que ApplySkillEffect).
+int escala(int base, RPG::Degree g);
+// "id#opcion" -> {id, opcion}
+std::pair<std::string, std::string> partirAccion(const std::string& accion);
+bool empiezaPor(const std::string& texto, const std::string& prefijo);
+// "otono" -> "Otono": la opcion como se ensena.
+std::string capitalizar(std::string texto);
+
+}  // namespace cartas
+
+struct CartasEnCombate::Invocacion {
+    std::unique_ptr<cartas::Invocado> cuerpo;
+    std::size_t aliado = 0;
+    int rondas = -1;
+};
+
+}  // namespace Game
diff --git a/src/Game/CartasJugar.cpp b/src/Game/CartasJugar.cpp
new file mode 100644
index 0000000..b55150c
--- /dev/null
+++ b/src/Game/CartasJugar.cpp
@@ -0,0 +1,304 @@
+// H2-06 — Jugar una carta de la mano: lo que hace cada gancho al jugarla
+// (ver include/Game/GanchosCarta.h). Las tiradas y los golpes estan en
+// CartasTiradas.cpp.
+#include "CartasEnCombateInterno.h"
+
+#include <map>
+
+namespace Game {
+
+using T = Gancho::Tipo;
+using namespace cartas;
+
+namespace {
+
+bool contraEnemigos(RPG::SkillTarget t) {
+    return t == RPG::SkillTarget::SINGLE_ENEMY || t == RPG::SkillTarget::ALL_ENEMIES ||
+           t == RPG::SkillTarget::ZONE_RADIUS;
+}
+
+std::string turnos(int rondas) {
+    if (rondas < 0) return "todo el combate";
+    return std::to_string(rondas) + (rondas == 1 ? " turno" : " turnos");
+}
+
+// Lo que de verdad sube la vida (con la vida llena, una cura no cura nada).
+int curar(ICombatant& quien, int cantidad) {
+    const int antes = quien.health();
+    quien.heal(cantidad);
+    return quien.health() - antes;
+}
+
+}  // namespace
+
+std::vector<CartasEnCombate::Ref> CartasEnCombate::objetivos(const ContextoBatalla& c,
+                                                             RPG::SkillTarget t,
+                                                             int elegido) const {
+    std::vector<Ref> salida;
+    const auto todos = [&](Lado lado) {
+        const std::size_t n = lado == Lado::Aliado ? c.aliados.size() : c.enemigos.size();
+        for (std::size_t i = 0; i < n; ++i) {
+            if (vivo(c, {lado, i})) salida.push_back({lado, i});
+        }
+    };
+    const auto uno = [&](Lado lado, int porDefecto) {
+        const std::size_t n = lado == Lado::Aliado ? c.aliados.size() : c.enemigos.size();
+        if (elegido >= 0 && static_cast<std::size_t>(elegido) < n &&
+            vivo(c, {lado, static_cast<std::size_t>(elegido)})) {
+            salida.push_back({lado, static_cast<std::size_t>(elegido)});
+        } else if (porDefecto >= 0) {
+            salida.push_back({lado, static_cast<std::size_t>(porDefecto)});
+        }
+    };
+    switch (t) {
+        case RPG::SkillTarget::SELF: salida.push_back({Lado::Aliado, 0}); break;
+        case RPG::SkillTarget::SINGLE_ALLY: uno(Lado::Aliado, 0); break;
+        case RPG::SkillTarget::ALL_ALLIES: todos(Lado::Aliado); break;
+        case RPG::SkillTarget::ALL_ENEMIES: todos(Lado::Enemigo); break;
+        case RPG::SkillTarget::SINGLE_ENEMY:
+        case RPG::SkillTarget::ZONE_RADIUS:  // sin posiciones: la zona es el objetivo elegido
+            uno(Lado::Enemigo, primerVivo(c, Lado::Enemigo));
+            break;
+    }
+    return salida;
+}
+
+EstadoCarta CartasEnCombate::estadoDeCondicion(const std::string& id, int rondas) const {
+    EstadoCarta e;
+    e.id = id;
+    const RPG::ConditionDefinition* def = m_catalogo.condicion(id);
+    e.nombre = def != nullptr ? def->name : id;
+    for (const Gancho& g : m_catalogo.ganchosDeCondicion(id)) {
+        if (g.esRasgo() && g.tipo != T::Ignorado) e.rasgos.push_back(g);
+    }
+    if (rondas > 0) {
+        e.rondas = rondas;
+    } else if (def != nullptr &&
+               def->durationMode == RPG::ConditionDefinition::Duration::ROUNDS) {
+        e.rondas = def->defaultRounds;
+    }
+    return e;
+}
+
+void CartasEnCombate::ponerEstado(ContextoBatalla& c, Ref quien, const EstadoCarta& estado) {
+    auto& estados = situ(quien).estados;
+    for (EstadoCarta& e : estados) {
+        if (e.id == estado.id) {
+            e = estado;  // la misma carta otra vez: se refresca, no se apila
+            return;
+        }
+    }
+    estados.push_back(estado);
+    c.log.push_back(nombre(c, quien) + " queda con " + estado.nombre + " (" + turnos(estado.rondas) + ").");
+}
+
+void CartasEnCombate::invocar(ContextoBatalla& c, const std::string& id, int rondas) {
+    const RPG::SummonDefinition* def = m_catalogo.invocacion(id);
+    if (def == nullptr) {
+        c.log.push_back("No existe la invocacion \"" + id + "\".");
+        return;
+    }
+    auto inv = std::make_unique<Invocacion>();
+    inv->cuerpo = std::make_unique<Invocado>(def->id, def->maxHealth > 0 ? def->maxHealth : 1, def->stats);
+    inv->aliado = c.aliados.size();
+    inv->rondas = rondas;
+    c.aliados.push_back(BattleParticipant{def->name, inv->cuerpo.get(), nullptr, nullptr});
+    asegurarTamanos(c);
+    c.log.push_back(c.aliados[0].name + " invoca a " + def->name + " (" + turnos(rondas) + ").");
+    m_invocaciones.push_back(std::move(inv));
+}
+
+bool CartasEnCombate::jugar(ContextoBatalla& c, std::size_t indice, const std::string& opcion,
+                            int objetivo) {
+    CartaEnMano& enMano = m_mano[indice];
+    const CatalogoCartas::Carta& carta = *enMano.carta;
+    const RPG::SkillDefinition& def = *carta.def;
+    const std::string motivo = motivoCarta(indice);
+    if (!motivo.empty()) {
+        c.log.push_back(c.aliados[0].name + " no puede usar " + def.name + ": " + motivo + ".");
+        m_turno.abierto = !m_turno.principal;
+        return false;
+    }
+    const Ref heroe{Lado::Aliado, 0};
+    if (def.action_type == RPG::ActionType::REACTION) {
+        m_turno.preparada = static_cast<int>(indice);
+        const std::vector<Ref> para = objetivos(c, def.target, objetivo);
+        m_turno.preparadaPara = !para.empty() && para[0].lado == Lado::Aliado ? para[0].i : 0;
+        c.log.push_back(c.aliados[0].name + " prepara " + def.name + ".");
+        m_turno.abierto = !m_turno.principal;
+        return true;
+    }
+
+    const std::vector<Ref> principales = objetivos(c, def.target, objetivo);
+    // Los golpes y el dano van siempre al bando contrario, aunque la carta
+    // apunte a ti (Arsenal del Rey: «invocas un arma que ataca por ti»).
+    const std::vector<Ref> golpeados =
+        contraEnemigos(def.target) ? principales
+                                   : objetivos(c, RPG::SkillTarget::SINGLE_ENEMY, -1);
+    std::map<std::size_t, Tirada> tiradas;  // una tirada enfrentada por enemigo y carta
+    const auto tiradaDe = [&](Ref r) -> const Tirada& {
+        auto it = tiradas.find(r.i);
+        if (it == tiradas.end()) it = tiradas.emplace(r.i, tirar(c, heroe, r, def, false, false)).first;
+        return it->second;
+    };
+    // Los estados de la carta, uno por duracion (Cancion del Invierno deja
+    // UN estado con sus dos rasgos).
+    std::map<int, EstadoCarta> estados;
+    for (const Gancho& g : carta.ganchos) {
+        if (g.tipo != T::Estado) continue;
+        EstadoCarta& e = estados[g.rondas];
+        e.id = def.id + (estados.size() > 1 ? "#" + std::to_string(g.rondas) : std::string());
+        e.nombre = def.name;
+        e.rondas = g.rondas;
+        e.rasgos.push_back(g.rasgo[0]);
+    }
+
+    c.log.push_back(c.aliados[0].name + " juega " + def.name + ".");
+    int danoCausado = 0;
+    bool turnoExtra = false;
+    for (const Gancho& g : carta.ganchos) {
+        switch (g.tipo) {
+            case T::Dano:
+            case T::DanoEscudo: {
+                int base = 0;
+                if (g.tipo == T::DanoEscudo) {
+                    base = situ(heroe).escudo;
+                    situ(heroe).escudo = 0;
+                    situ(heroe).escudoPorGolpe = 0;
+                }
+                for (const Ref& r : golpeados) {
+                    const Tirada& t = tiradaDe(r);
+                    const int dano = escala(g.tipo == T::Dano ? g.dados.tirar(c.rng) : base, t.grado);
+                    c.log.push_back(def.name + " sobre " + nombre(c, r) + " (" + t.resumen + ": " +
+                                    std::to_string(dano) + " de dano).");
+                    danoCausado += aplicarDano(c, heroe, r, dano, false);
+                }
+                break;
+            }
+            case T::Cura:
+                for (const Ref& r : contraEnemigos(def.target) ? std::vector<Ref>{heroe} : principales) {
+                    const Tirada t = tirarSinRival(c, heroe, def);
+                    int cura = escala(g.dados.tirar(c.rng), t.grado);
+                    for (const RasgoActivo& rasgo : rasgosDe(c, heroe)) {
+                        if (rasgo.g.tipo == T::BonoCura && cura > 0) cura += rasgo.g.numero;
+                    }
+                    const int curado = curar(*combatiente(c, r), cura);
+                    c.log.push_back(curado > 0 ? def.name + " cura " + std::to_string(curado) + " a " +
+                                                     nombre(c, r) + " (" + t.resumen + ")."
+                                               : def.name + ": " + nombre(c, r) + " ya tiene la vida llena.");
+                }
+                break;
+            case T::CuraDanoCausado:
+                if (danoCausado > 0) {
+                    const int curado = curar(*combatiente(c, heroe), danoCausado);
+                    c.log.push_back(curado > 0 ? c.aliados[0].name + " se cura " + std::to_string(curado) + "."
+                                               : c.aliados[0].name + " ya tiene la vida llena.");
+                }
+                break;
+            case T::AtaqueArma:
+                for (const Ref& r : golpeados) danoCausado += golpeDeArma(c, heroe, r, &g);
+                break;
+            case T::AtaquesArma: {
+                // Hasta N armas «a uno o varios enemigos»: se reparten entre los
+                // vivos empezando por el elegido.
+                const std::vector<Ref> vivos = objetivos(c, RPG::SkillTarget::ALL_ENEMIES, -1);
+                std::size_t inicio = 0;
+                for (std::size_t k = 0; k < vivos.size(); ++k) {
+                    if (!golpeados.empty() && vivos[k].i == golpeados[0].i) inicio = k;
+                }
+                for (int n = 0; n < g.numero && !vivos.empty(); ++n) {
+                    const Ref r = vivos[(inicio + static_cast<std::size_t>(n)) % vivos.size()];
+                    if (vivo(c, r)) danoCausado += golpeDeArma(c, heroe, r, nullptr);
+                }
+                break;
+            }
+            case T::Estado: {
+                auto it = estados.find(g.rondas);
+                if (it == estados.end()) break;  // ya puesto (el estado agrupa sus rasgos)
+                EstadoCarta e = it->second;
+                estados.erase(it);
+                e.origenAliado = true;
+                e.origen = 0;
+                for (const Ref& r : principales) {
+                    if (r.lado == Lado::Enemigo && tiradaDe(r).grado < RPG::Degree::SUCCESS) {
+                        c.log.push_back(nombre(c, r) + " resiste " + def.name + " (" + tiradaDe(r).resumen + ").");
+                        continue;
+                    }
+                    ponerEstado(c, r, e);
+                }
+                break;
+            }
+            case T::Condicion:
+                for (const Ref& r : principales) {
+                    if (r.lado != Lado::Enemigo || tiradaDe(r).grado < RPG::Degree::SUCCESS) continue;
+                    EstadoCarta e = estadoDeCondicion(g.texto, g.rondas);
+                    e.origen = 0;
+                    ponerEstado(c, r, e);
+                }
+                break;
+            case T::Escudo:
+                situ(heroe).escudoPorGolpe = g.numero;
+                situ(heroe).escudoMax = g.maximo;
+                c.log.push_back(c.aliados[0].name + " levanta " + def.name + " (cada golpe le da " +
+                                std::to_string(g.numero) + ", hasta " + std::to_string(g.maximo) + ").");
+                break;
+            case T::TurnoExtra:
+                for (const Ref& r : principales) {
+                    if (r.i == 0) {
+                        turnoExtra = true;
+                        c.log.push_back(c.aliados[0].name + " gana un turno adicional.");
+                    } else if (const int e = primerVivo(c, Lado::Enemigo); e >= 0) {
+                        golpeDeArma(c, r, {Lado::Enemigo, static_cast<std::size_t>(e)}, nullptr);
+                    }
+                }
+                break;
+            case T::DevuelveCarta: {
+                const int j = indiceEnMano(opcion);
+                if (j >= 0 && m_mano[static_cast<std::size_t>(j)].gastada) {
+                    m_mano[static_cast<std::size_t>(j)].gastada = false;
+                    c.log.push_back(m_mano[static_cast<std::size_t>(j)].carta->def->name + " vuelve a la mano.");
+                }
+                break;
+            }
+            case T::Invoca:
+                invocar(c, opcion.empty() && !g.opciones.empty() ? g.opciones[0] : opcion, g.rondas);
+                break;
+            case T::AliadoAtaca: {
+                Gancho exito;
+                exito.tipo = T::AtaqueArma;
+                exito.numero = 1;
+                exito.texto = "exito";  // «tu aliado no tira dados»
+                for (const Ref& r : principales) {
+                    if (r.i != 0 && vivo(c, r) && !golpeados.empty()) golpeDeArma(c, r, golpeados[0], &exito);
+                }
+                break;
+            }
+            case T::PendienteParcial:
+                c.log.push_back("(" + def.name + ": pendiente " + g.texto + ")");
+                break;
+            default:
+                break;
+        }
+    }
+    enMano.gastada = true;
+    enMano.ordenGasto = ++m_turno.gastos;
+    switch (def.action_type) {
+        case RPG::ActionType::FREE_ACTION:
+            break;
+        case RPG::ActionType::CHANNEL:
+            m_turno.canalizacion = true;
+            break;
+        case RPG::ActionType::MOVEMENT:
+            m_turno.movimiento = true;
+            break;
+        default:
+            if (!turnoExtra) {
+                cerrarTurno(c);
+                return true;
+            }
+    }
+    m_turno.abierto = !m_turno.principal;
+    return true;
+}
+
+}  // namespace Game
diff --git a/src/Game/CartasTiradas.cpp b/src/Game/CartasTiradas.cpp
new file mode 100644
index 0000000..8aa6399
--- /dev/null
+++ b/src/Game/CartasTiradas.cpp
@@ -0,0 +1,431 @@
+// H2-06 — Las tiradas de la mesa, los golpes, el dano y las reacciones, y el
+// turno de los enemigos contra todo eso. Toda tirada pasa por SkillExecutor
+// (Ed. 3, enfrentada) con las ventajas, desventajas y dados de mas que dicen
+// los estados de los dos lados.
+#include "CartasEnCombateInterno.h"
+
+#include <algorithm>
+#include <cstdio>
+
+#include "Game/Skill.h"
+#include "RPG/CharacterSheet.h"
+#include "RPG/ConditionEngine.h"
+#include "RPG/Definitions/SkillDefinition.h"
+#include "RPG/EnhanceHooks.h"
+
+namespace Game {
+
+using T = Gancho::Tipo;
+using namespace cartas;
+
+namespace {
+
+bool hay(const std::vector<RasgoActivo>& rasgos, T tipo) {
+    return std::any_of(rasgos.begin(), rasgos.end(), [tipo](const RasgoActivo& r) { return r.g.tipo == tipo; });
+}
+
+int suma(const std::vector<RasgoActivo>& rasgos, T tipo) {
+    int total = 0;
+    for (const RasgoActivo& r : rasgos) {
+        if (r.g.tipo == tipo) total += r.g.numero;
+    }
+    return total;
+}
+
+// ¿Lo puso este? (rasgos con origen: marca, provocacion)
+bool puestoPor(const RasgoActivo& r, bool aliado, std::size_t i) {
+    return r.conOrigen && r.origenAliado == aliado && r.origen == i;
+}
+
+// Ventaja y desventaja a la vez se anulan.
+RPG::DiceMod mod(bool ventaja, bool desventaja) {
+    if (ventaja == desventaja) return RPG::DiceMod::NORMAL;
+    return ventaja ? RPG::DiceMod::ADVANTAGE : RPG::DiceMod::DISADVANTAGE;
+}
+
+std::string exitos(float n) {
+    char buf[16];
+    std::snprintf(buf, sizeof buf, n == static_cast<int>(n) ? "%.0f" : "%.1f", static_cast<double>(n));
+    std::string s = buf;
+    std::replace(s.begin(), s.end(), '.', ',');
+    return s;
+}
+
+}  // namespace
+
+ICombatant* CartasEnCombate::combatiente(const ContextoBatalla& c, Ref quien) const {
+    const auto& lado = quien.lado == Lado::Aliado ? c.aliados : c.enemigos;
+    return quien.i < lado.size() ? lado[quien.i].combatant : nullptr;
+}
+
+const std::string& CartasEnCombate::nombre(const ContextoBatalla& c, Ref quien) const {
+    static const std::string nadie = "?";
+    const auto& lado = quien.lado == Lado::Aliado ? c.aliados : c.enemigos;
+    return quien.i < lado.size() ? lado[quien.i].name : nadie;
+}
+
+bool CartasEnCombate::vivo(const ContextoBatalla& c, Ref quien) const {
+    const ICombatant* x = combatiente(c, quien);
+    return x != nullptr && x->isAlive();
+}
+
+SituacionCombate& CartasEnCombate::situ(Ref quien) {
+    auto& lado = quien.lado == Lado::Aliado ? m_aliados : m_enemigos;
+    if (lado.size() <= quien.i) lado.resize(quien.i + 1);
+    return lado[quien.i];
+}
+
+int CartasEnCombate::primerVivo(const ContextoBatalla& c, Lado lado) const {
+    const std::size_t n = lado == Lado::Aliado ? c.aliados.size() : c.enemigos.size();
+    for (std::size_t i = 0; i < n; ++i) {
+        if (vivo(c, {lado, i})) return static_cast<int>(i);
+    }
+    return -1;
+}
+
+// Todo lo que pesa ahora sobre "quien": sus estados de la mesa, las
+// condiciones de su ficha (si tiene) y, si es el heroe, su pasiva elegida.
+std::vector<RasgoActivo> CartasEnCombate::rasgosDe(const ContextoBatalla& c, Ref quien) const {
+    std::vector<RasgoActivo> rasgos;
+    const auto& lado = quien.lado == Lado::Aliado ? m_aliados : m_enemigos;
+    if (quien.i < lado.size()) {
+        for (const EstadoCarta& e : lado[quien.i].estados) {
+            for (const Gancho& g : e.rasgos) rasgos.push_back({g, true, e.origenAliado, e.origen});
+        }
+    }
+    if (quien.lado == Lado::Aliado && quien.i == 0 && !m_pasiva.elegida.empty()) {
+        for (const Gancho& g : m_pasiva.condicionales) {
+            const bool vigente = g.rondas < 0 || m_turno.ronda < m_pasiva.rondaEleccion + g.rondas;
+            if (g.texto == m_pasiva.elegida && vigente && !g.rasgo.empty()) {
+                rasgos.push_back({g.rasgo[0], false, true, 0});
+            }
+        }
+    }
+    if (const ICombatant* x = combatiente(c, quien)) {
+        if (const RPG::CharacterSheet* ficha = x->character_sheet()) {
+            for (const auto& activa : ficha->conditions) {
+                for (const Gancho& g : m_catalogo.ganchosDeCondicion(activa.conditionId)) {
+                    if (g.esRasgo() && g.tipo != T::Ignorado) rasgos.push_back({g, false, true, 0});
+                }
+            }
+        }
+    }
+    return rasgos;
+}
+
+bool CartasEnCombate::tiene(const ContextoBatalla& c, Ref quien, T tipo) const {
+    return hay(rasgosDe(c, quien), tipo);
+}
+
+void CartasEnCombate::gastarPreparada(ContextoBatalla& c) {
+    if (m_turno.preparada < 0) return;
+    CartaEnMano& cm = m_mano[static_cast<std::size_t>(m_turno.preparada)];
+    cm.gastada = true;
+    cm.ordenGasto = ++m_turno.gastos;
+    m_turno.preparada = -1;
+    m_turno.reaccionUsada = true;
+    (void)c;
+}
+
+// Egida Divina: «+2d6 a la tirada de un aliado». Salta en la proxima tirada
+// del aliado protegido, ataque o defensa.
+int CartasEnCombate::dadosExtraDe(ContextoBatalla& c, Ref quien) {
+    if (m_turno.preparada < 0 || m_turno.reaccionUsada || quien.lado != Lado::Aliado ||
+        quien.i != m_turno.preparadaPara) {
+        return 0;
+    }
+    const CatalogoCartas::Carta& carta = *m_mano[static_cast<std::size_t>(m_turno.preparada)].carta;
+    for (const Gancho& g : carta.ganchos) {
+        if (g.tipo != T::DadosExtra) continue;
+        c.log.push_back(carta.def->name + ": +" + std::to_string(g.numero) + " dados para " + nombre(c, quien) + ".");
+        gastarPreparada(c);
+        return g.numero;
+    }
+    return 0;
+}
+
+Tirada CartasEnCombate::tirar(ContextoBatalla& c, Ref atacante, Ref defensor,
+                              const RPG::SkillDefinition& def, bool fisico, bool ventaja) {
+    const ICombatant& atk = *combatiente(c, atacante);
+    const ICombatant& dfn = *combatiente(c, defensor);
+    const std::vector<RasgoActivo> ra = rasgosDe(c, atacante);
+    const std::vector<RasgoActivo> rd = rasgosDe(c, defensor);
+    bool contraOrigen = false;
+    for (const RasgoActivo& r : rd) {
+        contraOrigen |= r.g.tipo == T::VentajaContraOrigen &&
+                        puestoPor(r, atacante.lado == Lado::Aliado, atacante.i);
+    }
+
+    RPG::Stat stat = RPG::Stat::DES;
+    switch (def.save_attribute) {
+        case RPG::SaveAttribute::CON: stat = RPG::Stat::CON; break;
+        case RPG::SaveAttribute::INT: stat = RPG::Stat::INT; break;
+        case RPG::SaveAttribute::CAR: stat = RPG::Stat::CAR; break;
+        default: stat = dfn.stat(RPG::Stat::CON) > dfn.stat(RPG::Stat::DES) ? RPG::Stat::CON : RPG::Stat::DES;
+    }
+    const bool defensaFisica = stat == RPG::Stat::CON || stat == RPG::Stat::DES;
+
+    RPG::ExecutionContext ctx;
+    ctx.skill = &def;
+    ctx.rng = &c.rng;
+    ctx.override_base_dice =
+        std::max(0, 1 + atk.stat(def.casting_stat) + dadosExtraDe(c, atacante) - suma(ra, T::PenalDados));
+    ctx.force_dice_mod = mod(ventaja || hay(ra, T::VentajaAtaque) || hay(rd, T::VentajaContraTodo) ||
+                                 (fisico && hay(rd, T::VentajaContraMelee)) || contraOrigen,
+                             hay(ra, T::DesventajaTodo) || hay(ra, T::DesventajaAtaque));
+    ctx.override_target_dice = std::max(0, dfn.stat(stat) + (fisico ? suma(rd, T::BonoCa) : 0) +
+                                               dadosExtraDe(c, defensor) - suma(rd, T::PenalDados));
+    ctx.defender_dice_mod =
+        mod(hay(rd, T::VentajaDefensa), hay(rd, T::DesventajaTodo) || hay(rd, T::DesventajaDefensa) ||
+                                            (defensaFisica && hay(rd, T::DesventajaDefensaFisica)));
+    const RPG::SkillExecutor::Out out = RPG::SkillExecutor::execute(ctx);
+    Tirada t;
+    t.grado = out.final_degree;
+    t.magnitud = out.final_magnitude;
+    if (t.grado >= RPG::Degree::SUCCESS && hay(rd, T::CriticoContra)) {
+        t.grado = RPG::Degree::CRITICAL;
+        t.magnitud = def.magnitude(RPG::Degree::CRITICAL);
+    }
+    t.resumen = std::string(gradoTexto(t.grado)) + ", " + exitos(out.effective_successes) + " contra " +
+                exitos(out.defender_pool.successes);
+    return t;
+}
+
+Tirada CartasEnCombate::tirarSinRival(ContextoBatalla& c, Ref quien, const RPG::SkillDefinition& def) {
+    const std::vector<RasgoActivo> r = rasgosDe(c, quien);
+    RPG::ExecutionContext ctx;
+    ctx.skill = &def;
+    ctx.rng = &c.rng;
+    ctx.override_base_dice = std::max(0, 1 + combatiente(c, quien)->stat(def.casting_stat) +
+                                             dadosExtraDe(c, quien) - suma(r, T::PenalDados));
+    ctx.force_dice_mod = mod(hay(r, T::VentajaAtaque), hay(r, T::DesventajaTodo) || hay(r, T::DesventajaAtaque));
+    const RPG::SkillExecutor::Out out = RPG::SkillExecutor::execute(ctx);
+    Tirada t;
+    t.grado = out.final_degree;
+    t.magnitud = out.final_magnitude;
+    t.resumen = std::string(gradoTexto(t.grado)) + ", " + exitos(out.effective_successes) + " exitos";
+    return t;
+}
+
+// Golpe de arma (Atacar, las cartas de ataque y las invocaciones). Devuelve
+// la vida que de verdad quita (Furia: Fe se cura eso).
+int CartasEnCombate::golpeDeArma(ContextoBatalla& c, Ref atacante, Ref objetivo, const Gancho* variante) {
+    if (!vivo(c, atacante) || !vivo(c, objetivo)) return 0;
+    if (situ(objetivo).protector >= 0) objetivo = {Lado::Aliado, static_cast<std::size_t>(situ(objetivo).protector)};
+    if (tiene(c, objetivo, T::BloqueaTodos)) {
+        c.log.push_back(nombre(c, objetivo) + " contrarresta el golpe de " + nombre(c, atacante) + ".");
+        return 0;
+    }
+    static const RPG::SkillDefinition basico = definicionAtaqueBasico();
+    const std::string modo = variante != nullptr ? variante->texto : std::string();
+    Tirada t;
+    if (modo == "critico" || modo == "exito") {
+        t.grado = modo == "critico" ? RPG::Degree::CRITICAL : RPG::Degree::SUCCESS;
+        t.magnitud = basico.magnitude(t.grado);
+        t.resumen = std::string(gradoTexto(t.grado)) + " sin tirar";
+    } else {
+        t = tirar(c, atacante, objetivo, basico, true, modo == "ventaja");
+    }
+    int dano = t.magnitud;
+    if (dano > 0) {
+        for (const RasgoActivo& r : rasgosDe(c, atacante)) {
+            if (r.g.tipo == T::BonoDanoArma || r.g.tipo == T::BonoDanoMelee) dano += r.g.dados.tirar(c.rng);
+        }
+        for (const RasgoActivo& r : rasgosDe(c, objetivo)) {
+            // «+1d6 de dano» de quien te marco; sin origen (una condicion
+            // del catalogo), de cualquiera.
+            if (r.g.tipo == T::BonoDanoContra &&
+                (!r.conOrigen || puestoPor(r, atacante.lado == Lado::Aliado, atacante.i))) {
+                dano += r.g.dados.tirar(c.rng);
+            }
+        }
+        if (variante != nullptr && variante->numero > 1) dano *= variante->numero;
+    }
+    c.log.push_back(nombre(c, atacante) + " ataca a " + nombre(c, objetivo) + " (" + t.resumen + ": " +
+                    std::to_string(dano) + " de dano).");
+    const int perdido = aplicarDano(c, atacante, objetivo, dano, true);
+    SituacionCombate& yo = situ(atacante);
+    if (dano > 0 && yo.escudoPorGolpe > 0 && yo.escudo < yo.escudoMax) {
+        yo.escudo = std::min(yo.escudoMax, yo.escudo + yo.escudoPorGolpe);
+        c.log.push_back("Escudo de " + nombre(c, atacante) + ": " + std::to_string(yo.escudo) + ".");
+    }
+    return perdido;
+}
+
+int CartasEnCombate::aplicarDano(ContextoBatalla& c, Ref fuente, Ref objetivo, int cantidad, bool fisico) {
+    if (cantidad <= 0 || !vivo(c, objetivo)) return 0;
+    if (fisico && tiene(c, objetivo, T::Refleja) && vivo(c, fuente)) {
+        combatiente(c, fuente)->takeDamage(cantidad);
+        c.log.push_back(nombre(c, objetivo) + " refleja el golpe: " + nombre(c, fuente) + " recibe " +
+                        std::to_string(cantidad) + ".");
+        trasDano(c, fuente);
+        return 0;
+    }
+    SituacionCombate& s = situ(objetivo);
+    const int absorbido = std::min(s.escudo, cantidad);
+    if (absorbido > 0) {
+        s.escudo -= absorbido;
+        cantidad -= absorbido;
+        c.log.push_back("El escudo de " + nombre(c, objetivo) + " absorbe " + std::to_string(absorbido) + ".");
+    }
+    ICombatant& x = *combatiente(c, objetivo);
+    const int antes = x.health();
+    x.takeDamage(cantidad);
+    const int perdido = antes - x.health();
+    if (perdido > 0 && c.condiciones != nullptr && x.character_sheet() != nullptr) {
+        RPG::ConditionEngine::on_damage_received(*x.character_sheet(), *c.condiciones, perdido);
+    }
+    trasDano(c, objetivo);
+    return perdido;
+}
+
+// Despues de un golpe: Ultimo Aliento si cae un aliado, y si cae el heroe sus
+// invocaciones se desvanecen con el (la batalla la pierde el heroe).
+void CartasEnCombate::trasDano(ContextoBatalla& c, Ref objetivo) {
+    if (objetivo.lado != Lado::Aliado || vivo(c, objetivo)) return;
+    if (m_turno.preparada >= 0 && !m_turno.reaccionUsada && objetivo.i == m_turno.preparadaPara) {
+        const CatalogoCartas::Carta& carta = *m_mano[static_cast<std::size_t>(m_turno.preparada)].carta;
+        for (const Gancho& g : carta.ganchos) {
+            if (g.tipo != T::Revive) continue;
+            combatiente(c, objetivo)->heal(g.numero);
+            c.log.push_back(carta.def->name + ": " + nombre(c, objetivo) + " vuelve con " +
+                            std::to_string(g.numero) + " PV.");
+            gastarPreparada(c);
+            return;
+        }
+    }
+    if (objetivo.i == 0) {
+        for (const auto& inv : m_invocaciones) inv->cuerpo->desvanecer();
+    }
+}
+
+// Las reacciones que saltan ANTES de que un enemigo tire: bloquear el golpe
+// (y cegar al atacante), contrarrestarlo todo durante el turno, o ponerse
+// delante de un aliado. true = el golpe no llega.
+bool CartasEnCombate::reaccionAntesDelGolpe(ContextoBatalla& c, Ref atacante, Ref& objetivo) {
+    if (m_turno.preparada < 0 || m_turno.reaccionUsada) return false;
+    const CatalogoCartas::Carta& carta = *m_mano[static_cast<std::size_t>(m_turno.preparada)].carta;
+    const std::string& carta_nombre = carta.def->name;
+    for (const Gancho& g : carta.ganchos) {
+        if ((g.tipo == T::Bloquea || g.tipo == T::BloqueaTodos) && objetivo.i == 0) {
+            c.log.push_back(carta_nombre + ": " + nombre(c, objetivo) + " bloquea el ataque de " +
+                            nombre(c, atacante) + ".");
+            for (const Gancho& otro : carta.ganchos) {
+                if (otro.tipo == T::Condicion) {
+                    EstadoCarta e = estadoDeCondicion(otro.texto, otro.rondas);
+                    e.origen = 0;
+                    ponerEstado(c, atacante, e);
+                }
+            }
+            if (g.tipo == T::BloqueaTodos) {
+                EstadoCarta e;
+                e.id = carta.def->id;
+                e.nombre = carta_nombre;
+                e.rondas = g.rondas;
+                Gancho rasgo;
+                rasgo.tipo = T::BloqueaTodos;
+                e.rasgos.push_back(rasgo);
+                ponerEstado(c, objetivo, e);
+            }
+            gastarPreparada(c);
+            return true;
+        }
+        if (g.tipo == T::DefiendeAliado && objetivo.i != 0 && objetivo.lado == Lado::Aliado &&
+            vivo(c, {Lado::Aliado, 0})) {
+            c.log.push_back(carta_nombre + ": " + nombre(c, {Lado::Aliado, 0}) + " se interpone por " +
+                            nombre(c, objetivo) + ".");
+            situ(objetivo).protector = 0;
+            objetivo = {Lado::Aliado, 0};
+            gastarPreparada(c);
+            return false;
+        }
+    }
+    return false;
+}
+
+void CartasEnCombate::turnoInvocaciones(ContextoBatalla& c) {
+    for (const auto& inv : m_invocaciones) {
+        const Ref yo{Lado::Aliado, inv->aliado};
+        if (!vivo(c, yo) || tiene(c, yo, T::Incapacitado)) continue;
+        const int e = primerVivo(c, Lado::Enemigo);
+        if (e < 0) return;
+        golpeDeArma(c, yo, {Lado::Enemigo, static_cast<std::size_t>(e)}, nullptr);
+    }
+}
+
+bool CartasEnCombate::resolverEnemigo(ContextoBatalla& c, std::size_t enemigo) {
+    asegurarTamanos(c);
+    const Ref yo{Lado::Enemigo, enemigo};
+    BattleParticipant& p = c.enemigos[enemigo];
+    const std::vector<RasgoActivo> mios = rasgosDe(c, yo);
+    if (hay(mios, T::Incapacitado)) {
+        c.log.push_back(p.name + " no puede actuar.");
+        return true;
+    }
+    int destino = primerVivo(c, Lado::Aliado);
+    for (const RasgoActivo& r : mios) {
+        if (r.g.tipo == T::Provocado && r.conOrigen && r.origenAliado && vivo(c, {Lado::Aliado, r.origen})) {
+            destino = static_cast<int>(r.origen);  // Ira Imparable: te ataca a ti
+        }
+    }
+    if (destino < 0) return true;
+    Ref objetivo{Lado::Aliado, static_cast<std::size_t>(destino)};
+
+    // La IA de siempre (BattleState::resolveEnemyTurn): la primera habilidad
+    // conocida que pueda pagar; si no, golpe de arma.
+    const Skill* elegida = nullptr;
+    if (p.skills != nullptr && c.habilidadesLegado != nullptr) {
+        for (const std::string& id : p.skills->knownSkillIds()) {
+            const Skill* s = c.habilidadesLegado->find(id);
+            if (s != nullptr && p.skills->canUse(*s)) {
+                elegida = s;
+                break;
+            }
+        }
+    }
+    if (elegida != nullptr && (elegida->target == SkillTarget::Self || elegida->target == SkillTarget::SingleAlly ||
+                               elegida->target == SkillTarget::AllAllies)) {
+        p.skills->spend(*elegida);
+        const SkillApplyResult r = ApplySkillEffect(*elegida, *p.combatant, *p.combatant, c.rng);
+        c.log.push_back(p.name + " usa " + elegida->name + " (+" + std::to_string(r.hpChange) + " PV).");
+        return true;
+    }
+    if (elegida == nullptr && hay(mios, T::Desarmado)) {
+        c.log.push_back(p.name + " esta desarmado y no puede atacar.");
+        return true;
+    }
+    if (situ(objetivo).protector >= 0) objetivo = {Lado::Aliado, static_cast<std::size_t>(situ(objetivo).protector)};
+    if (reaccionAntesDelGolpe(c, yo, objetivo)) return true;
+    if (elegida == nullptr) {
+        golpeDeArma(c, yo, objetivo, nullptr);
+        return true;
+    }
+    if (tiene(c, objetivo, T::BloqueaTodos)) {
+        c.log.push_back(nombre(c, objetivo) + " contrarresta " + elegida->name + ".");
+        return true;
+    }
+    p.skills->spend(*elegida);
+    const RPG::SkillDefinition def = definicionDeHabilidad(*elegida);
+    const Tirada t = tirar(c, yo, objetivo, def, true, false);
+    c.log.push_back(p.name + " usa " + elegida->name + " sobre " + nombre(c, objetivo) + " (" + t.resumen +
+                    ": " + std::to_string(t.magnitud) + ").");
+    aplicarDano(c, yo, objetivo, t.magnitud, true);
+    if (!def.apply_condition_id.empty() && t.grado >= def.apply_condition_min_degree && vivo(c, objetivo)) {
+        RPG::CharacterSheet* ficha = combatiente(c, objetivo)->character_sheet();
+        const RPG::ConditionDefinition* cond = m_catalogo.condicion(def.apply_condition_id);
+        if (ficha != nullptr && cond != nullptr && c.condiciones != nullptr) {
+            // Con ficha, la condicion va a la ficha como siempre (D-09): dura
+            // mas alla del combate si la carta lo dice.
+            RPG::ConditionEngine::apply(*ficha, *cond, *c.condiciones);
+            c.log.push_back(p.name + " aplica " + cond->name + " a " + nombre(c, objetivo) + ".");
+        } else {
+            EstadoCarta e = estadoDeCondicion(def.apply_condition_id, def.condition_duration_rounds);
+            e.origenAliado = false;
+            e.origen = enemigo;
+            ponerEstado(c, objetivo, e);
+        }
+    }
+    return true;
+}
+
+}  // namespace Game
