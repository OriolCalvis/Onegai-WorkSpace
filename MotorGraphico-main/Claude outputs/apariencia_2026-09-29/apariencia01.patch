diff --git a/include/Game/Personajes/EditorApariencia.h b/include/Game/Personajes/EditorApariencia.h
new file mode 100644
index 0000000..b8f6ea5
--- /dev/null
+++ b/include/Game/Personajes/EditorApariencia.h
@@ -0,0 +1,88 @@
+// APARIENCIA-01 — El paso «Apariencia» de Nueva partida, sin ventana.
+//
+// Lo que el probador web de ARTE-02 hacia con selectores, en filas que se
+// recorren con W/S y se cambian con izquierda/derecha: piel y talla (solo los
+// pueblos de cuerpo liso), ojos, peinado y su color, barba y su color, y la
+// ropa de diario (cabeza, torso, piernas, pies y capa). Mas dos acciones:
+// AL AZAR y COMO SU RAZA. Las armas no estan: se ven cuando se equipan.
+//
+// Las filas dependen de la raza (un aarakocra no tiene pelo ni pies; una
+// naga no tiene piernas) y de lo elegido (sin peinado no hay color de pelo).
+// Cambiar de raza devuelve la apariencia a la de la raza nueva; volver a la
+// misma raza conserva lo elegido.
+//
+// AL AZAR es determinista (una semilla que avanza) para poder probarlo.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "Game/Personajes/ManifiestoPersonajes.h"
+
+namespace Game {
+
+class EditorApariencia {
+public:
+    enum class Fila {
+        Piel,
+        Talla,
+        Ojos,
+        Peinado,
+        ColorPelo,
+        Barba,
+        ColorBarba,
+        Cabeza,
+        Torso,
+        Piernas,
+        Pies,
+        Capa,
+        AlAzar,
+        ComoSuRaza
+    };
+
+    explicit EditorApariencia(const ManifiestoPersonajes& manifiesto);
+
+    // Apariencia de la raza, salvo que ya se estuviera editando esa raza.
+    void empezar(const std::string& razaId);
+    const Apariencia& apariencia() const { return m_apariencia; }
+    const ManifiestoPersonajes& manifiesto() const { return m_manifiesto; }
+
+    const std::vector<Fila>& filas() const { return m_filas; }
+    std::size_t marcada() const { return m_marcada; }
+    Fila filaMarcada() const { return m_filas.empty() ? Fila::AlAzar : m_filas[m_marcada]; }
+
+    void arriba();
+    void abajo();
+    // Cambian el valor de la fila marcada (con la vuelta al llegar al final);
+    // en AL AZAR y COMO SU RAZA hacen la accion.
+    void izquierda();
+    void derecha();
+
+    // Lo que se pinta: "PEINADO", "Corto", el detalle del pie y el icono.
+    static const char* etiqueta(Fila fila);
+    static const char* ayuda(Fila fila);
+    static const char* icono(Fila fila);
+    std::string valor(Fila fila) const;
+
+    // Nombres para el jugador de los ids del manifiesto que no traen nombre
+    // (pieles, tallas, ojos, peinados, colores, barbas).
+    static std::string nombreDe(const std::string& id);
+
+private:
+    void rehacerFilas();
+    void cambiar(Fila fila, int paso);
+    void alAzar();
+    std::vector<std::string> opciones(Fila fila) const;
+    std::string actual(Fila fila) const;
+    void poner(Fila fila, const std::string& valor);
+
+    const ManifiestoPersonajes& m_manifiesto;
+    Apariencia m_apariencia;
+    std::vector<Fila> m_filas;
+    std::size_t m_marcada = 0;
+    std::uint32_t m_tirada = 0;  // AL AZAR: cuantas veces se ha pulsado
+};
+
+}  // namespace Game
diff --git a/include/Game/Personajes/ManifiestoPersonajes.h b/include/Game/Personajes/ManifiestoPersonajes.h
new file mode 100644
index 0000000..861f9be
--- /dev/null
+++ b/include/Game/Personajes/ManifiestoPersonajes.h
@@ -0,0 +1,112 @@
+// APARIENCIA-01 — El contrato de los personajes por capas, leido para el motor.
+//
+// ARTE-02 dejo el arte y su contrato (assets/textures/personajes.json, que
+// genera tools/gen_personajes.py) y un probador en Python que monta cualquier
+// personaje. Faltaba que el juego supiera leerlo. Esto son los DATOS: que
+// razas hay y con que capas, que peinados, barbas, pieles, ojos y piezas de
+// equipo, en que atlas y en que fila de cada talla, en que orden se dibuja
+// cada ranura segun hacia donde mira, y que pieza se ve de cada objeto de
+// equipment.json (personajes/equipo_catalogo.json).
+//
+// GL-free a proposito: el montaje (MontajePersonajes), el editor de la
+// creacion (EditorApariencia) y las pruebas lo usan sin abrir una ventana.
+// Quien pinta es Render/HojaPersonaje.
+#pragma once
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "Core/Errors/Result.h"
+
+class JsonValue;
+
+namespace Game {
+
+// Una fila de un atlas de capas: un peinado, una barba, una piel, un color de
+// ojos o una pieza de equipo. Filas 1-based, como en el JSON.
+struct FilaDeCapa {
+    std::string id;      // "corto/pelo_castano", "piel_clara", "azul", "capucha_gris"
+    std::string estilo;  // pelo y barba: "corto", "BARBA"
+    std::string color;   // pelo y barba: "pelo_castano"
+    std::string nombre;  // piezas de equipo: "Capucha gris"
+    int fila = 0;
+};
+
+// Un atlas por talla ("medio", "bajo", "pequeno", "grande" y, en torso y
+// capa, "medio_sin_piernas") y las filas que tiene.
+struct GrupoDeCapas {
+    std::map<std::string, std::string> atlas;  // talla -> ruta relativa a assets/textures
+    std::vector<FilaDeCapa> filas;
+    std::vector<std::string> ocultaPelo;  // solo cabeza: los yelmos cerrados
+    const FilaDeCapa* buscar(const std::string& id) const;
+};
+
+struct RazaVisual {
+    std::string id, nombre, talla, tallaRopa;
+    int fila = 0;
+    std::vector<std::string> capas;  // "cuerpo", "alas", "morro", "rasgos"...
+    std::vector<std::string> sin;    // ranuras que no admite: "pelo", "pies"...
+    std::string piel;                // vacio = cuerpo con rasgos propios
+    std::string ojos;
+    std::string peloEstilo, peloColor, barbaEstilo, barbaColor;  // vacio = no tiene
+    std::map<std::string, std::string> equipo;                   // como va vestida
+    // Solo una raza de cuerpo liso, en una piel del atlas de cuerpos, admite
+    // otra piel u otra talla: el cuerpo sale entonces de ese atlas (probador).
+    bool cuerpoLiso = false;
+    bool admite(const std::string& ranura) const;  // la ranura no esta en `sin`
+};
+
+// Como se ve un personaje, explicito: lo que el jugador elige al crearlo y lo
+// que describe una entrada de "personajes" en personajes.json.
+struct Apariencia {
+    std::string raza;
+    std::string piel;                         // vacio o la de la raza = el cuerpo de la raza
+    std::string talla;                        // vacio o la de la raza = su talla
+    std::string ojos;                         // vacio = los de la raza
+    std::string peloEstilo, peloColor;        // estilo vacio = sin pelo
+    std::string barbaEstilo, barbaColor;      // estilo vacio = sin barba
+    std::map<std::string, std::string> ropa;  // ranura -> pieza
+    std::vector<std::string> quitarCapas;     // capas de la raza que no se pintan
+
+    // La raza tal cual la viste personajes.json. conArmas=false deja fuera
+    // arma y mano_izq: el jugador las lleva cuando equipa un objeto.
+    static Apariencia deRaza(const RazaVisual& raza, bool conArmas = false);
+    // Texto estable: dos apariencias con la misma clave montan la misma hoja.
+    std::string clave() const;
+};
+
+// La pieza que se ve de un objeto de equipment.json.
+struct PiezaDeObjeto {
+    std::string ranura;  // cabeza, torso, piernas, pies, capa, arma o mano_izq
+    std::string pieza;
+};
+
+// Ranuras de equipo en el orden en que se apilan, y las que son ropa (usan
+// la talla de ropa de la raza: nagas y espectros visten sin piernas).
+extern const char* const kRanurasDeEquipo[7];
+bool esRanuraDeRopa(const std::string& ranura);
+
+struct ManifiestoPersonajes {
+    std::map<std::string, std::map<std::string, int>> orden;  // ranura -> direccion -> z
+    std::map<std::string, std::string> nombreDeTalla;         // "medio" -> "Normal"
+    std::map<std::string, std::string> atlasDeRaza;           // capa -> ruta
+    std::vector<RazaVisual> razas;                            // orden de races.json
+    GrupoDeCapas cuerpos, ojos, pelo, barba;
+    std::map<std::string, GrupoDeCapas> equipo;          // ranura -> piezas
+    std::map<std::string, Apariencia> personajes;        // actores + historia
+    std::map<std::string, PiezaDeObjeto> piezaDeObjeto;  // objeto -> pieza
+
+    // Lee personajes.json y personajes/equipo_catalogo.json de la carpeta.
+    static Result<ManifiestoPersonajes> cargar(
+        const std::string& carpetaTexturas = "assets/textures");
+
+    const RazaVisual* raza(const std::string& id) const;
+    // Una composicion como las de "personajes" o las "composicion" de los
+    // atlas horneados: {"raza", "piel", "talla", "ojos", "pelo": [estilo,
+    // color] | null, "barba": ..., "equipo": {...}, "quitar_capas": [...]}.
+    // Sin "pelo" o sin "barba" valen los de la raza.
+    Result<Apariencia> desdeComposicion(const JsonValue& spec) const;
+};
+
+}  // namespace Game
diff --git a/include/Game/Personajes/MontajePersonajes.h b/include/Game/Personajes/MontajePersonajes.h
new file mode 100644
index 0000000..3edbde8
--- /dev/null
+++ b/include/Game/Personajes/MontajePersonajes.h
@@ -0,0 +1,98 @@
+// APARIENCIA-01 — Montar un personaje por capas: la hoja de 12 frames.
+//
+// Hace lo mismo que tools/probador_personaje.py, que es lo que ARTE-02 dejo
+// escrito que tendria que hacer el motor: de cada atlas coge la fila de cada
+// capa y, frame a frame, las dibuja una encima de otra en el orden de su
+// ranura para la direccion del frame. La mezcla es la aritmetica entera de
+// Pillow (Image.alpha_composite), asi que la hoja sale IGUAL, byte a byte,
+// que la del probador y que los atlas horneados (la prueba lo comprueba con
+// los 62 personajes de actores_capas, razas_andando y personajes_historia).
+//
+// Los atlas se leen de disco la primera vez y se quedan en una cache con
+// presupuesto (los de las razas pesan 8,5 MB cada uno ya descomprimidos):
+// si se pasa, se sueltan los que hace mas tiempo que no se usan.
+//
+// GL-free: devuelve pixeles. Quien los sube a una textura es
+// Render/HojaPersonaje.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <list>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "Core/Errors/Result.h"
+#include "Core/Imagen/ImagenRGBA.h"
+#include "Game/Personajes/ManifiestoPersonajes.h"
+
+namespace Game {
+
+// Una capa de un personaje: la fila `fila` (1-based) del atlas `atlas`,
+// que se ordena al apilar como la ranura `ranura`.
+struct CapaDeMontaje {
+    std::string ranura;  // "cuerpo", "ojos", "pelo", "torso", "arma"...
+    std::string atlas;   // ruta relativa a la carpeta de texturas
+    int fila = 0;
+};
+
+class MontajePersonajes {
+public:
+    static constexpr int kLado = 64;    // un frame
+    static constexpr int kFrames = 12;  // arriba 1-3, derecha 4-6, abajo 7-9, izquierda 10-12
+    static constexpr std::size_t kPresupuestoPorDefecto = 96u * 1024u * 1024u;
+
+    MontajePersonajes(ManifiestoPersonajes manifiesto, std::string carpetaTexturas,
+                      std::size_t presupuestoBytes = kPresupuestoPorDefecto);
+    // Lee el manifiesto de la carpeta y deja el montaje listo.
+    static Result<std::unique_ptr<MontajePersonajes>> cargar(
+        const std::string& carpetaTexturas = "assets/textures");
+
+    const ManifiestoPersonajes& manifiesto() const { return m_manifiesto; }
+
+    // Las capas en el orden en que se apilan (el capas() del probador). El
+    // `equipo` (ranura visual -> pieza) va encima de la ropa de la
+    // apariencia: es lo que el personaje lleva puesto.
+    Result<std::vector<CapaDeMontaje>> capas(
+        const Apariencia& apariencia, const std::map<std::string, std::string>& equipo = {}) const;
+
+    // La hoja de 12 frames: 768x64, fila 0 arriba, lista para una textura.
+    Result<imagen::ImagenRGBA> montar(const Apariencia& apariencia,
+                                      const std::map<std::string, std::string>& equipo = {});
+
+    void vaciarCache();
+    std::size_t bytesEnCache() const { return m_bytes; }
+
+private:
+    Result<const imagen::ImagenRGBA*> atlas(const std::string& ruta);
+    void recortarCache();
+
+    ManifiestoPersonajes m_manifiesto;
+    std::string m_carpeta;
+    std::size_t m_presupuesto;
+    std::list<std::pair<std::string, imagen::ImagenRGBA>> m_cache;  // delante, la mas reciente
+    std::size_t m_bytes = 0;
+};
+
+// Mezcla el pixel RGBA `encima` sobre `debajo`, en su sitio, con la misma
+// aritmetica entera que Image.alpha_composite de Pillow.
+void mezclarEncima(std::uint8_t* debajo, const std::uint8_t* encima);
+
+// --- El reparto de la hoja ---------------------------------------------
+// Cada rumbo tiene tres frames: paso, quieto, paso.
+enum class Rumbo { Arriba = 0, Derecha = 1, Abajo = 2, Izquierda = 3 };
+Rumbo rumboDeFrame(int frame);           // frame 1..12
+const char* nombreDeRumbo(Rumbo rumbo);  // "arriba", "derecha", "abajo", "izquierda"
+int frameQuieto(Rumbo rumbo);            // 2, 5, 8, 11
+// El ciclo de andar EMPEZANDO por el frame quieto ({8, 7, 8, 9} hacia
+// abajo): Player descansa en el primer frame de su animacion, y con el
+// ciclo de los atlas horneados ({7, 8, 9, 8}) se quedaria a medio paso.
+std::vector<int> cicloDeAndar(Rumbo rumbo);
+// La vista previa de la creacion anda y va girando: abajo, derecha,
+// arriba, izquierda. Que frame toca a los `segundos` de abrirla.
+int frameDeVistaPrevia(double segundos);
+
+}  // namespace Game
