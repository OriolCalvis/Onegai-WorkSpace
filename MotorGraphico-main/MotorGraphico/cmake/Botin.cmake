# AV18-03: cartas prestadas por piezas únicas, sin cambiar las reglas de combate.
target_sources(motor_level PRIVATE src/Game/ContenedoresEquipo.cpp)
if(BUILD_TESTING)
    add_executable(test_botin_equipo tests/Game/BotinEquipoTests.cpp)
    target_include_directories(test_botin_equipo PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/tests")
    target_link_libraries(test_botin_equipo PRIVATE motor_level)
    add_test(NAME test_botin_equipo COMMAND test_botin_equipo)
    set_tests_properties(test_botin_equipo PROPERTIES WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" LABELS "unit;gl-free")
    set_property(GLOBAL APPEND PROPERTY MOTOR_GL_FREE_TARGETS test_botin_equipo)
    if(MOTOR_PYTHON3)
        add_test(NAME test_validar_botin COMMAND "${MOTOR_PYTHON3}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/test_validar_botin.py")
        set_tests_properties(test_validar_botin PROPERTIES LABELS "unit;gl-free")
    endif()
endif()
