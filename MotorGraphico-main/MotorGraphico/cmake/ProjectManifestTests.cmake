include(CTest)
if(BUILD_TESTING)
    if(TARGET motor_project)
        add_executable(test_project_manifests tests/Project/ManifestTests.cpp)
        target_link_libraries(test_project_manifests PRIVATE motor_project)
        add_dependencies(test_project_manifests copiar_assets)
        add_test(NAME test_project_manifests COMMAND test_project_manifests "${CMAKE_BINARY_DIR}/assets")
        set_tests_properties(test_project_manifests PROPERTIES LABELS "unit;gl-free")
        set_property(GLOBAL APPEND PROPERTY MOTOR_GL_FREE_TARGETS test_project_manifests)
        if(TARGET suite_gl_free)
            add_dependencies(suite_gl_free test_project_manifests)
        endif()
    endif()
    find_package(Python3 QUIET COMPONENTS Interpreter)
    if(Python3_Interpreter_FOUND)
        add_test(NAME test_project_migration
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/Project/test_manifest_migration.py")
        set_tests_properties(test_project_migration PROPERTIES LABELS "unit;gl-free")
    endif()
endif()
