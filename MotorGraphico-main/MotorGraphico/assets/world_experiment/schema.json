{
  "schema_version": "1.0",
  "package_files": [
    "manifest.json",
    "geography.json",
    "locations.json",
    "history.json",
    "cultures.json",
    "factions.json",
    "connections.json",
    "README.md"
  ],
  "allowed_status": [
    "canon_previo",
    "experimental",
    "variante",
    "borrador",
    "pendiente"
  ],
  "allowed_milestone_types": [
    "settlement",
    "clan",
    "city_state",
    "confederation",
    "kingdom",
    "refoundation",
    "renaming"
  ],
  "allowed_name_relations": [
    "same_place",
    "ancestor_name",
    "renaming",
    "dynastic_name",
    "editorial_label",
    "collision_pending"
  ],
  "location_required_fields": [
    "id",
    "kind",
    "region",
    "era_start",
    "era_end",
    "name_current",
    "names_historical",
    "name_relation",
    "status"
  ]
}
