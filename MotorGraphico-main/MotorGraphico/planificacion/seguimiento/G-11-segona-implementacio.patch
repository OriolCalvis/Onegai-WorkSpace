diff -ruN '--exclude=build' '--exclude=_glad_off' '--exclude=third_party' mg/cmake/SaveSlotTests.cmake mg-g11/cmake/SaveSlotTests.cmake
--- mg/cmake/SaveSlotTests.cmake	1970-01-01 00:00:00.000000000 +0000
+++ mg-g11/cmake/SaveSlotTests.cmake	2026-09-14 07:18:52.548118912 +0000
@@ -0,0 +1,28 @@
+# G-11 — Selector de guardados y recuperacion de derrota.
+#
+# GL-FREE A PROPOSITO: no enlaza motor_core (el target OpenGL), asi que se
+# ejecuta en cualquier contenedor sin X11/GLFW, igual que test_save_game.
+# Todo lo que prueba -- el servicio de ranuras, la clasificacion de los
+# guardados rotos, DEC-09 y el estado del selector -- vive en motor_level.
+#
+#   motor_map          entra por GameSession (TileMap), no porque el test
+#                      abra ningun TMX (el nivel de prueba va sin mapa).
+#   motor_map_document se necesita por MapEventDocument, que es lo que
+#                      recibe el planificador de eventos de E-03 en el
+#                      caso de la espera.
+include(CTest)
+if (BUILD_TESTING)
+    add_executable(test_save_slots tests/Game/SaveSlotTests.cpp)
+    target_include_directories(test_save_slots PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/tests")
+    target_link_libraries(test_save_slots
+        PRIVATE motor_level motor_map motor_map_document motor_rpg motor_json)
+    add_test(NAME test_save_slots COMMAND test_save_slots)
+    set_tests_properties(test_save_slots PROPERTIES
+        WORKING_DIRECTORY "${CMAKE_BINARY_DIR}"
+        LABELS "unit;gl-free"
+    )
+    set_property(GLOBAL APPEND PROPERTY MOTOR_GL_FREE_TARGETS test_save_slots)
+    if (TARGET suite_gl_free)
+        add_dependencies(suite_gl_free test_save_slots)
+    endif ()
+endif ()
