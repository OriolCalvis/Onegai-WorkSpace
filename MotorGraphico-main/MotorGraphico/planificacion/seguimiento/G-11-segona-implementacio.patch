+Game::SaveSlotService& Application::saveSlots() {
+    // Se rehace al cambiar de proyecto: las ranuras van por proyecto, y
+    // un servicio quedado del escenario anterior escribiria en las suyas.
+    if (m_saveSlots == nullptr || m_saveSlots->projectId() != m_currentProjectId) {
+        m_saveSlots = std::make_unique<Game::SaveSlotService>(m_currentProjectId);
+    }
+    return *m_saveSlots;
