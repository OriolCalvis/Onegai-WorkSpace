+// ---------------------------------------------------------------------
+// 6. DEC-09 — guardar solo en puntos seguros, y decir por que si no
+// ---------------------------------------------------------------------
+
+MOTOR_TEST_CASE(dec09_guardar_en_punto_inseguro_se_bloquea_con_motivo) {
+    SaveSlotService service = serviceFor("g11_dec09", "2026-06-06 05:00:00");
+    wipe(service);
+    const std::string ranura = SaveSlotService::numberedSlotId(1);
+
+    // (a) Exploracion limpia: es punto seguro.
+    Partida p;
+    MOTOR_CHECK(SaveSlotService::checkSafePoint(p.session).safe);
+    MOTOR_CHECK(SaveSlotService::checkSafePoint(p.session).reason.empty());
+
+    // (b) En combate: no. Entrar en la celda del slime abre el combate.
+    Partida combate;
+    for (int i = 0; i < 5; ++i) {
+        combate.session.tryMovePlayer(1, 0);
+    }
+    MOTOR_CHECK(combate.session.mode() == GameMode::Battle);
+    const auto enCombate = SaveSlotService::checkSafePoint(combate.session);
+    MOTOR_CHECK(!enCombate.safe);
+    MOTOR_CHECK(enCombate.reason.find("combate") != std::string::npos);
+
+    const auto bloqueado = service.saveFrom(ranura, combate.session, "assets/levels/x.json");
+    MOTOR_CHECK(!bloqueado.ok);
+    MOTOR_CHECK(!bloqueado.needsOverwriteConfirm);  // no es falta de permiso: es DEC-09
+    MOTOR_CHECK(bloqueado.problem == enCombate.reason);
+    // Y no se ha creado ningun fichero.
+    MOTOR_CHECK(service.describe(ranura).status == SaveSlotStatus::Empty);
+
+    // (c) En dialogo: tampoco. El aldeano esta en (3,1); el jugador llega
+    // a (3,0) y habla.
+    Partida dialogo;
+    dialogo.session.tryMovePlayer(1, 0);
+    dialogo.session.tryMovePlayer(1, 0);
+    dialogo.session.tryMovePlayer(1, 0);
+    MOTOR_CHECK(dialogo.session.interact());
+    MOTOR_CHECK(dialogo.session.mode() == GameMode::Dialogue);
+    const auto enDialogo = SaveSlotService::checkSafePoint(dialogo.session);
+    MOTOR_CHECK(!enDialogo.safe);
+    MOTOR_CHECK(enDialogo.reason.find("conversacion") != std::string::npos);
+    MOTOR_CHECK(!service.saveFrom(ranura, dialogo.session, "assets/levels/x.json").ok);
+    MOTOR_CHECK(service.describe(ranura).status == SaveSlotStatus::Empty);
+
+    // Al cerrar el dialogo vuelve a ser punto seguro, sin que nadie haya
+    // tenido que acordarse de bajar una bandera.
+    dialogo.session.closeInteraction();
+    MOTOR_CHECK(SaveSlotService::checkSafePoint(dialogo.session).safe);
+
+    // (d) Con una espera del planificador de eventos viva (E-03): tampoco.
+    HostQueEspera host;
+    RPG::EventInterpreter interprete(host);
+    MOTOR_CHECK(interprete.canSave());
+    MOTOR_CHECK(SaveSlotService::checkSafePoint(p.session, &interprete).safe);
+
+    MOTOR_CHECK(interprete.start(eventoConEspera(), 0).isOk());
+    interprete.tick(16);  // el comando devuelve Wait: la ejecucion sigue viva
+    MOTOR_CHECK(!interprete.canSave());
+    const auto enEspera = SaveSlotService::checkSafePoint(p.session, &interprete);
+    MOTOR_CHECK(!enEspera.safe);
+    MOTOR_CHECK(enEspera.reason.find("escena") != std::string::npos);
+    MOTOR_CHECK(!service.saveFrom(ranura, p.session, "assets/levels/x.json", &interprete).ok);
+    MOTOR_CHECK(service.describe(ranura).status == SaveSlotStatus::Empty);
+
+    // Cancelada la escena, la misma sesion vuelve a poder guardar.
+    interprete.cancelAll();
+    interprete.collectFinished();
+    MOTOR_CHECK(SaveSlotService::checkSafePoint(p.session, &interprete).safe);
+    MOTOR_CHECK(service.saveFrom(ranura, p.session, "assets/levels/x.json", &interprete).ok);
+    MOTOR_CHECK(service.describe(ranura).status == SaveSlotStatus::Ready);
+
+    wipe(service);
+}
