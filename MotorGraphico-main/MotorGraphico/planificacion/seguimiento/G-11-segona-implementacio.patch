+    screen.select(ranura);
+    MOTOR_CHECK(screen.confirm() == SaveSlotAction::None);
+    MOTOR_CHECK(screen.message() == info.problemText);
+
+    // Un fichero que es JSON valido pero no es un guardado: mismo trato.
