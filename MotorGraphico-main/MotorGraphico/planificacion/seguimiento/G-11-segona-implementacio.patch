+// G-11 — Selector de guardados y recuperacion de derrota.
+//
+// El "por que" de cada decision esta en include/Game/SaveSlotState.h (donde
+// viven los ficheros, por que una lista fija de ranuras, por que DEC-09 se
+// deriva en vez de llevar bandera). Aqui va el como.
+
+#include "Game/SaveSlotState.h"
+
+#include <algorithm>
+#include <ctime>
+#include <fstream>
+#include <sstream>
+#include <utility>
+
+#include "Core/Json/JsonValue.h"
+#include "Game/GameSession.h"
+#include "RPG/EventInterpreter.h"
+
+namespace Game {
+
+namespace {
+
+// selectedSlot() devuelve referencia: con la lista vacia (defensivo, no
+// pasa desde open()) devuelve esta fila neutra en vez de una referencia
+// colgando. Mismo recurso que TitleScreen::kNoEntry.
+const SaveSlotInfo kNoSlot{};
+
+std::string readWholeFile(const std::string& path, bool* exists) {
+    std::ifstream file(path, std::ios::binary);
+    if (!file) {
+        if (exists != nullptr) {
+            *exists = false;
+        }
+        return std::string();
+    }
+    if (exists != nullptr) {
+        *exists = true;
+    }
+    std::ostringstream buffer;
+    buffer << file.rdbuf();
+    return buffer.str();
+}
+
+// Etiqueta visible de una ranura a partir de su id.
+std::string labelFor(const std::string& slotId) {
+    if (slotId == SaveSlotService::quickSlotId()) {
+        return "Guardado rapido";
+    }
+    for (int i = 1; i <= SaveSlotService::kNumberedSlots; ++i) {
+        if (slotId == SaveSlotService::numberedSlotId(i)) {
+            return "Ranura " + std::to_string(i);
+        }
+    }
+    return slotId;
+}
+
+// Motivo en claro de por que la sesion no esta en un punto seguro. Se
+// deriva del GameMode que ya existe: no hay ningun estado nuevo que
+// mantener sincronizado.
+const char* reasonForMode(GameMode mode) {
+    switch (mode) {
+        case GameMode::Battle:
+            return "No se puede guardar en mitad de un combate.";
+        case GameMode::Dialogue:
+            return "No se puede guardar en mitad de una conversacion.";
+        case GameMode::Shop:
+            return "No se puede guardar con la tienda abierta.";
+        case GameMode::Business:
+            return "No se puede guardar con el negocio abierto.";
+        case GameMode::Pause:
+            return "No se puede guardar desde este menu.";
+        case GameMode::GameOver:
+            return "No se puede guardar una partida perdida.";
+        case GameMode::Exploration:
+            break;
+    }
+    return "";
+}
