+    // formato que TitleScreen::labels().
+    std::vector<std::string> labels() const;
+    // Texto de una fila: "Ranura 1  Maria - ciudad.json - 2026-09-14 12:00"
+    static std::string describeLine(const SaveSlotInfo& info);
+
+private:
