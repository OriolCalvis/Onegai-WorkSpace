+// G-11 — Selector de guardados y recuperacion de derrota.
+//
+// GL-free: sin ventana, sin contexto OpenGL y sin assets en disco mas que
+// los ficheros temporales que el propio test escribe y borra (mismo
+// criterio que tests/Game/SaveGameTests.cpp, de donde salen el ICombatant
+// de prueba, el catalogo y el nivel sin mapa).
+//
+// Cubre, en este orden, los seis casos que pide el criterio de cierre:
+//   1. dos proyectos no comparten ranuras
+//   2. sobrescribir exige confirmacion
+//   3. cancelar el sobrescrito no toca nada
+//   4. ranura corrupta: motivo, y la partida EN CURSO intacta
+//   5. version incompatible: motivo distinto del anterior
+//   6. DEC-09: guardar en punto inseguro se bloquea diciendo por que
+// y ademas: "Continuar" elige la mas reciente, F5/F9 usan el mismo
+// servicio, la ficha del slot no rompe los guardados antiguos, y lo
+// recuperado conserva inventario, oro, moral, variables y flags sin
+// repetir lo ya cobrado.
+
+#include "TestHarness.h"
+
+#include "Core/Json/JsonValue.h"
+#include "Game/GameOverScreen.h"
+#include "Game/GameSession.h"
+#include "Game/SaveGame.h"
+#include "Game/SaveSlotState.h"
+#include "Game/Skill.h"
+#include "Level/ObjectCatalog.h"
+#include "Map/EventLayerDocument.h"
+#include "RPG/EventInterpreter.h"
+#include "RPG/NarrativeEngine.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+using Game::SaveSlotAction;
+using Game::SaveSlotInfo;
+using Game::SaveSlotMode;
+using Game::SaveSlotProblem;
+using Game::SaveSlotScreen;
+using Game::SaveSlotService;
+using Game::SaveSlotStatus;
+using Game::SaveSlotWrite;
+
+// --- Dobles de prueba (copiados de SaveGameTests.cpp: misma familia) ---
+
+class TestCombatant : public ICombatant {
+public:
+    explicit TestCombatant(int maxHealth) : m_health(maxHealth), m_maxHealth(maxHealth) {}
+
+    void takeDamage(int amount) override { m_health = std::max(0, m_health - amount); }
+    void heal(int amount) override { m_health = std::min(m_maxHealth, m_health + amount); }
+    int health() const override { return m_health; }
+    int maxHealth() const override { return m_maxHealth; }
+    bool isAlive() const override { return m_health > 0; }
+
+    int stat(RPG::Stat /*s*/) const override { return 0; }
+    RPG::DefenseBlock defenses() const override { return {}; }
+    int tier() const override { return 1; }
+    std::string combatant_id() const override { return "test"; }
+
+private:
+    int m_health;
+    int m_maxHealth;
+};
+
+ObjectCatalog makeCatalog() {
+    ObjectCatalog catalog;
+    auto result = catalog.loadFromString(R"({
+        "objects": [
+            {"id": "pocion", "name": "Pocion", "category": "pickup",
+             "pickup": {"effect": "heal", "power": 15}},
+            {"id": "antorcha", "name": "Antorcha", "category": "pickup",
+             "pickup": {"effect": "heal", "power": 1}},
+            {"id": "aldeano", "name": "Aldeano", "category": "npc",
+             "dialogue": ["Buenos dias."]},
+            {"id": "slime", "name": "Slime", "category": "enemy",
+             "combat": {"maxHealth": 10, "maxMana": 0, "skills": []}}
+        ]
+    })");
+    MOTOR_CHECK(result.isOk());
+    return catalog;
+}
+
+// Nivel sin mapa: dos pickups, un NPC y un enemigo, en fila.
+//   (0,0) jugador   (1,0) pocion   (2,0) antorcha
+//   (3,1) aldeano   (5,0) slime
+LevelDefinition makeLevel() {
+    LevelDefinition level;
+    level.name = "Ranuras";
+    level.playerStart = GridCoord{0, 0};
+    level.objects.push_back(
+        ObjectSpawn{"pocion", GridCoord{1, 0}, GridCoord{1, 0}, GridCoord{1, 0}});
+    level.objects.push_back(
+        ObjectSpawn{"antorcha", GridCoord{2, 0}, GridCoord{2, 0}, GridCoord{2, 0}});
+    level.objects.push_back(
+        ObjectSpawn{"aldeano", GridCoord{3, 1}, GridCoord{3, 1}, GridCoord{3, 1}});
+    level.objects.push_back(
+        ObjectSpawn{"slime", GridCoord{5, 0}, GridCoord{5, 0}, GridCoord{5, 0}});
+    return level;
+}
+
+// Una sesion jugable montada de una pieza, para no repetir seis variables
+// sueltas en cada caso. Los cuerpos viven aqui porque la sesion los
+// referencia sin poseerlos.
+struct Partida {
+    ObjectCatalog catalog = makeCatalog();
+    SkillCatalog skills;
+    TestCombatant body{60};
+    SkillSet playerSkills{10};
+    std::vector<std::string> inventory;
+    RPG::NarrativeState narrative;
+    GameSession session{nullptr,      &catalog,      &skills, makeLevel(),
+                        &body,        &playerSkills, &inventory};
+
+    Partida() { session.setNarrative(nullptr, &narrative); }
+};
+
+// Servicio con reloj fijo: la ficha del slot deja de depender del reloj de
+// la maquina y el test puede afirmar la fecha exacta.
+SaveSlotService serviceFor(const std::string& projectId, const std::string& stamp) {
+    SaveSlotService service(projectId);
+    service.setClock([stamp] { return stamp; });
+    return service;
+}
+
+// Borra todas las ranuras de un proyecto (antes y despues de cada caso):
+// los tests corren en el directorio de build y no deben dejar residuos ni
+// heredar los de una ejecucion anterior.
+void wipe(const SaveSlotService& service) {
+    for (const std::string& id : service.slotIds()) {
+        std::remove(service.slotPath(id).c_str());
+    }
+}
+
+void writeRawFile(const std::string& path, const std::string& text) {
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    file.write(text.data(), static_cast<std::streamsize>(text.size()));
+}
+
+// Host minimo para el planificador de eventos (E-03): solo hace falta que
+// un comando pueda quedarse esperando.
+struct HostQueEspera : public RPG::EventHost {
+    RPG::CommandResult execute(const MapEventCommand& /*command*/) override {
+        RPG::CommandResult r;
+        r.outcome = RPG::CommandOutcome::Wait;
+        r.waitMs = 5000;  // espera larga: la ejecucion sigue viva
+        return r;
+    }
+};
+
+MapEventDocument eventoConEspera() {
+    MapEventCommand cmd;
+    cmd.type = "texto.mostrar";
+    MapEventPage pagina;
+    pagina.id = ids::EventId::parse("pg_espera").value();
+    pagina.trigger = EventTrigger::Autorun;
+    pagina.commands.push_back(std::move(cmd));
+    MapEventDocument evento;
+    evento.id = ids::EventId::parse("espera").value();
+    evento.pages.push_back(std::move(pagina));
+    return evento;
+}
