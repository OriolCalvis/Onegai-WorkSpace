diff -ruN '--exclude=build' '--exclude=_glad_off' '--exclude=third_party' mg/include/Game/SaveGame.h mg-g11/include/Game/SaveGame.h
--- mg/include/Game/SaveGame.h	2026-09-11 22:29:56.000000000 +0000
+++ mg-g11/include/Game/SaveGame.h	2026-09-14 07:12:38.024134067 +0000
@@ -114,6 +114,46 @@
     // claves que no conoce. Congelar los esquemas es G-07.
     std::map<std::string, int> narrativeVariables;
     std::vector<RPG::NarrativeState::LocalSwitches> narrativeLocalSwitches;
+
+    // G-11 — LA FICHA DEL SLOT. Lo que el selector de guardados enseña
+    // ANTES de cargar: de quien es la partida, donde estaba y de cuando
+    // es. Sin esto un slot es una fila que pone "ranura 2" y nada mas, y
+    // el jugador tiene que cargar para saber cual es cual.
+    //
+    // Van AQUI y no en un fichero indice aparte por lo mismo que el
+    // guardado se escribe atomicamente (ver writeSaveGameFile): un indice
+    // separado es un segundo fichero que se puede desincronizar del
+    // primero, y entonces el selector miente. La ficha viaja DENTRO del
+    // guardado, asi que o esta las dos cosas o no esta ninguna.
+    //
+    // schemaVersion NO sube, por el mismo motivo que E-02 documenta unas
+    // lineas mas arriba: el lector rechaza cualquier version que no sea la
+    // suya, y subirla dejaria ilegibles de golpe todas las partidas ya
+    // guardadas. Las tres claves son OPCIONALES al leer (un guardado
+    // anterior no las trae y entra con las tres vacias) y el escritor solo
+    // las pone cuando estan puestas de verdad, de modo que un guardado
+    // antiguo reescrito da EXACTAMENTE el mismo texto que antes.
+    //
+    // Un slot sin ficha no es corrupto: se enseña con lo que se sepa
+    // (levelPath siempre esta, que es obligatorio) y se carga igual.
+
+    // Proyecto al que pertenece la partida ("boundington"). Los slots ya
+    // van separados por nombre de fichero, asi que esto es la
+    // COMPROBACION, no el reparto: si un fichero acaba en la ranura de
+    // otro proyecto (una copia a mano, un pack movido), el selector lo
+    // marca y no lo carga en vez de mezclar dos campañas.
+    std::string projectId;
+
+    // Nombre visible del personaje (CharacterSheet::displayName). Vacio
+    // si la partida no tiene ficha todavia.
+    std::string characterName;
+
+    // Momento del guardado, "AAAA-MM-DD HH:MM:SS" en hora local. Texto y
+    // no un numero de epoch a proposito: es lo que se pinta tal cual, se
+    // lee a ojo al abrir el fichero, y ORDENA por comparacion de cadenas
+    // (el formato es lexicograficamente creciente), que es lo unico que
+    // "Continuar" necesita para dar con la partida mas reciente.
+    std::string savedAt;
 };
 
