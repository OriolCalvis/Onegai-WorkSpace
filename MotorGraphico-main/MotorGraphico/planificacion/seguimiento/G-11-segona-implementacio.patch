+    MOTOR_CHECK(screen.confirm() == SaveSlotAction::Load);
+
+    // Se recupera sobre una sesion RECIEN construida del mismo nivel, que
+    // es lo que hace la Application tras recargarlo.
+    Partida recuperada;
+    MOTOR_CHECK(recuperada.session.worldObjects().size() == 3);  // pocion, antorcha, aldeano
+
+    std::string motivo;
+    MOTOR_CHECK(service.restoreInto(screen.selectedSlotId(), recuperada.session, &motivo));
+    MOTOR_CHECK(motivo.empty());
+
+    MOTOR_CHECK(recuperada.session.playerPosition().x == 1);
+    MOTOR_CHECK(recuperada.session.gold() == 250);
+    MOTOR_CHECK(recuperada.session.morality().value() == -22);
+    MOTOR_CHECK(recuperada.body.health() == 42);
+    MOTOR_CHECK(recuperada.inventory.size() == 1);
+    MOTOR_CHECK(recuperada.inventory[0] == "pocion");
+    MOTOR_CHECK(recuperada.session.mode() == GameMode::Exploration);
+
+    // Nada de lo ya entregado se vuelve a entregar: la pocion recogida NO
+    // reaparece en el mundo y las banderas/beats siguen encendidos, que es
+    // lo que impide repetir el prologo o volver a cobrar la recompensa.
+    MOTOR_CHECK(recuperada.session.worldObjects().size() == 2);
+    for (const auto& obj : recuperada.session.worldObjects()) {
+        MOTOR_CHECK(obj.objectId != "pocion");
+    }
+    MOTOR_CHECK(recuperada.narrative.hasFlag("cofre_abierto"));
+    MOTOR_CHECK(recuperada.narrative.beatFired("beat_prologo"));
+    MOTOR_CHECK(recuperada.narrative.variable("hierbas") == 3);
+    MOTOR_CHECK(recuperada.narrative.localSwitch("cofre_plaza", 'A'));
+
+    wipe(service);
+}
