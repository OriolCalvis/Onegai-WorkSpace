+SaveSlotService::SaveSlotService(std::string projectId, std::string root)
+    : m_projectId(std::move(projectId)), m_root(std::move(root)) {}
+
+std::vector<std::string> SaveSlotService::slotIds() const {
+    std::vector<std::string> ids;
+    ids.reserve(static_cast<std::size_t>(kNumberedSlots) + 1);
+    for (int i = 1; i <= kNumberedSlots; ++i) {
+        ids.push_back(numberedSlotId(i));
+    }
+    // La rapida al final: es la del automatismo (F5/F9), no la primera
+    // que el jugador elige a mano.
+    ids.push_back(quickSlotId());
+    return ids;
+}
+
+std::string SaveSlotService::slotPath(const std::string& slotId) const {
+    // El id del proyecto va en el NOMBRE: es lo que hace que dos
+    // proyectos no compartan ranuras sin necesitar una carpeta por
+    // proyecto (y por tanto sin necesitar un mkdir que el motor no tiene).
+    const std::string name = "partida_" + m_projectId + "_" + slotId + ".json";
+    return m_root.empty() ? name : m_root + "/" + name;
+}
+
+// ---------------------------------------------------------------------
+// Fichas de las ranuras
+// ---------------------------------------------------------------------
+
+SaveSlotInfo SaveSlotService::describe(const std::string& slotId) const {
+    SaveSlotInfo info;
+    info.id = slotId;
+    info.label = labelFor(slotId);
+    info.path = slotPath(slotId);
+    info.quick = (slotId == quickSlotId());
+
+    bool exists = false;
+    const std::string text = readWholeFile(info.path, &exists);
+    if (!exists) {
+        info.status = SaveSlotStatus::Empty;
+        return info;
+    }
+
+    // Se clasifica el problema ANTES de dar por perdida la ranura: el
+    // criterio pide distinguir "corrupto" de "version incompatible", y son
+    // dos mensajes distintos para el jugador (uno se arregla borrando, el
+    // otro actualizando el juego).
+    const Result<JsonValue> parsed = JsonValue::parse(text);
+    if (parsed.isOk() && parsed.value().isObject() && parsed.value().has("schemaVersion") &&
+        parsed.value()["schemaVersion"].isNumber()) {
+        const int version = parsed.value()["schemaVersion"].asInt(0);
+        if (version != SaveGameData::kSchemaVersion) {
+            info.status = SaveSlotStatus::Broken;
+            info.problem = SaveSlotProblem::Incompatible;
+            info.problemText = "Partida de otra version (v" + std::to_string(version) +
+                               "; este juego lee v" +
+                               std::to_string(SaveGameData::kSchemaVersion) + ").";
+            return info;
+        }
+    }
+
+    SaveGameData data;
+    std::string error;
+    if (!parseSaveGame(text, &data, &error)) {
+        info.status = SaveSlotStatus::Broken;
+        info.problem = SaveSlotProblem::Unreadable;
+        info.problemText = error.empty() ? "Partida ilegible." : error;
+        return info;
+    }
+
+    // El fichero ya va separado por proyecto en el nombre, asi que esto
+    // solo salta si alguien lo ha movido a mano. Mejor negarse que mezclar
+    // dos campañas: es el mismo criterio que restoreSaveGame aplica cuando
+    // el nivel ha cambiado bajo la partida.
+    if (!data.projectId.empty() && data.projectId != m_projectId) {
+        info.status = SaveSlotStatus::Broken;
+        info.problem = SaveSlotProblem::ForeignProject;
+        info.problemText = "Esta partida es del proyecto '" + data.projectId + "'.";
+        return info;
+    }
+
+    info.status = SaveSlotStatus::Ready;
+    info.characterName = data.characterName;
+    info.levelPath = data.levelPath;
+    info.savedAt = data.savedAt;
+    info.gold = data.gold;
+    info.playerHealth = data.playerHealth;
+    info.playerMaxHealth = data.playerMaxHealth;
+    return info;
+}
+
+std::vector<SaveSlotInfo> SaveSlotService::listSlots() const {
+    std::vector<SaveSlotInfo> out;
+    const std::vector<std::string> ids = slotIds();
+    out.reserve(ids.size());
+    for (const std::string& id : ids) {
+        out.push_back(describe(id));
+    }
+    return out;
+}
+
+std::string SaveSlotService::mostRecentSlotId() const {
+    std::string bestId;
+    std::string bestStamp;
+    for (const SaveSlotInfo& info : listSlots()) {
+        if (!info.usable()) {
+            continue;
+        }
+        if (bestId.empty() || info.savedAt > bestStamp) {
+            bestId = info.id;
+            bestStamp = info.savedAt;
+        }
+    }
+    return bestId;
+}
+
+// ---------------------------------------------------------------------
+// DEC-09 — puntos seguros
+// ---------------------------------------------------------------------
+
+SafePoint SaveSlotService::checkSafePoint(const GameSession& session,
+                                          const RPG::EventInterpreter* events) {
+    SafePoint point;
+
+    const char* modeReason = reasonForMode(session.mode());
+    if (modeReason[0] != '\0') {
+        point.reason = modeReason;
+        return point;
+    }
+
+    // A mitad de un cambio de nivel la sesion que se fotografiaria ya no
+    // es la que se va a jugar: el guardado apuntaria al nivel viejo con la
+    // posicion del nuevo.
+    if (session.pendingTransition().pending) {
+        point.reason = "No se puede guardar mientras se cambia de nivel.";
+        return point;
+    }
+
+    // El planificador de eventos ya responde a esta pregunta desde E-03
+    // (EventInterpreter::canSave(): ninguna ejecucion viva). Guardar con
+    // un evento a medias exigiria serializar el programa, el punto de
+    // continuacion y el estado de espera, y decir que si aqui seria
+    // prometerlo. Sin planificador no hay nada que esperar.
+    if (events != nullptr && !events->canSave()) {
+        point.reason = "No se puede guardar mientras una escena esta en marcha.";
+        return point;
+    }
+
+    point.safe = true;
+    return point;
+}
+
+// ---------------------------------------------------------------------
+// Guardar
+// ---------------------------------------------------------------------
+
+SaveSlotWriteOutcome SaveSlotService::write(const std::string& slotId, SaveGameData data,
+                                            SaveSlotWrite mode) const {
+    SaveSlotWriteOutcome outcome;
+
+    const SaveSlotInfo current = describe(slotId);
+    if (current.status != SaveSlotStatus::Empty && mode != SaveSlotWrite::Overwrite) {
+        // No es un error: es que falta el si del jugador. Se distingue con
+        // needsOverwriteConfirm para que la pantalla abra la pregunta en
+        // vez de enseñar un fallo.
+        outcome.needsOverwriteConfirm = true;
+        outcome.problem = "La ranura ya tiene una partida.";
+        return outcome;
+    }
+
+    // La ficha del slot se estampa AQUI: la fecha la pone quien guarda (es
+    // el momento del guardado, no el de la captura) y el proyecto lo sabe
+    // el servicio, no la sesion.
+    data.projectId = m_projectId;
+    data.savedAt = nowStamp();
+
+    std::string error;
+    if (!writeSaveGameFile(slotPath(slotId), data, &error)) {
+        outcome.problem = error;
+        return outcome;
+    }
+    outcome.ok = true;
+    return outcome;
+}
+
+SaveSlotWriteOutcome SaveSlotService::saveFrom(const std::string& slotId,
+                                               const GameSession& session,
+                                               const std::string& levelPath,
+                                               const RPG::EventInterpreter* events,
+                                               SaveSlotWrite mode) const {
+    // DEC-09 PRIMERO. Si no es punto seguro no se captura ni se abre el
+    // fichero: el disco se queda exactamente como estaba y el jugador
+    // recibe el motivo.
+    const SafePoint point = checkSafePoint(session, events);
+    if (!point.safe) {
+        SaveSlotWriteOutcome outcome;
+        outcome.problem = point.reason;
+        return outcome;
+    }
+    return write(slotId, session.captureSaveGame(levelPath), mode);
+}
+
+// ---------------------------------------------------------------------
+// Cargar
+// ---------------------------------------------------------------------
+
+SaveSlotLoadOutcome SaveSlotService::load(const std::string& slotId) const {
+    SaveSlotLoadOutcome outcome;
+
+    // describe() ya lee y clasifica el fichero entero sin tocar nada vivo.
+    // Se reutiliza para no tener dos sitios donde decidir si una ranura
+    // sirve (y que se separarian con el tiempo).
+    const SaveSlotInfo info = describe(slotId);
+    if (info.status == SaveSlotStatus::Empty) {
+        outcome.problem = "La ranura esta vacia.";
+        return outcome;
+    }
+    if (info.status == SaveSlotStatus::Broken) {
+        outcome.problem = info.problemText;
+        outcome.kind = info.problem;
+        return outcome;
+    }
+
+    std::string error;
+    if (!readSaveGameFile(info.path, &outcome.data, &error)) {
+        // Solo se llega aqui si el fichero ha cambiado entre las dos
+        // lecturas. Sigue sin haberse tocado nada vivo.
+        outcome.data = SaveGameData{};
+        outcome.problem = error;
+        outcome.kind = SaveSlotProblem::Unreadable;
+        return outcome;
+    }
+    outcome.ok = true;
+    return outcome;
+}
+
+bool SaveSlotService::restoreInto(const std::string& slotId, GameSession& session,
+                                  std::string* problem) const {
+    // Paso 1: leer y validar el fichero ENTERO. Mientras esto no salga
+    // bien, la sesion viva no se ha tocado.
+    const SaveSlotLoadOutcome loaded = load(slotId);
+    if (!loaded.ok) {
+        if (problem != nullptr) {
+            *problem = loaded.problem;
+        }
+        return false;
+    }
+
+    // Paso 2: aplicarlo. restoreSaveGame valida contra el nivel en su
+    // fase 1 y no escribe nada hasta la fase 2, asi que un guardado que no
+    // encaje tampoco deja la sesion a medias.
+    std::string error;
+    if (!session.restoreSaveGame(loaded.data, &error)) {
+        if (problem != nullptr) {
+            *problem = error;
+        }
+        return false;
+    }
+    if (problem != nullptr) {
+        problem->clear();
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------------
+// Reloj
+// ---------------------------------------------------------------------
+
+void SaveSlotService::setClock(std::function<std::string()> clock) {
+    m_clock = std::move(clock);
+}
+
+std::string SaveSlotService::nowStamp() const {
+    return m_clock ? m_clock() : localTimeStamp();
+}
+
+std::string SaveSlotService::localTimeStamp() {
+    const std::time_t now = std::time(nullptr);
+    std::tm local{};
+#if defined(_WIN32)
+    localtime_s(&local, &now);
+#else
+    localtime_r(&now, &local);
+#endif
+    char buffer[32] = {0};
+    // Formato lexicograficamente ordenable a proposito (ver SaveGame.h).
+    if (std::strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", &local) == 0) {
+        return std::string();
+    }
+    return std::string(buffer);
+}
+
+// ---------------------------------------------------------------------
+// SaveSlotScreen — solo estado
+// ---------------------------------------------------------------------
+
+SaveSlotScreen SaveSlotScreen::open(const SaveSlotService& service, SaveSlotMode mode) {
+    SaveSlotScreen screen;
+    screen.m_mode = mode;
+    screen.m_slots = service.listSlots();
+    screen.m_selected = 0;
+    return screen;
+}
+
+void SaveSlotScreen::moveUp() {
+    if (m_slots.empty() || m_awaitingOverwrite) {
+        return;  // con la pregunta abierta el cursor no se mueve
+    }
+    m_selected = (m_selected == 0) ? m_slots.size() - 1 : m_selected - 1;
+    m_message.clear();
+}
+
+void SaveSlotScreen::moveDown() {
+    if (m_slots.empty() || m_awaitingOverwrite) {
+        return;
+    }
+    m_selected = (m_selected + 1) % m_slots.size();
+    m_message.clear();
+}
+
+void SaveSlotScreen::select(const std::string& slotId) {
+    for (std::size_t i = 0; i < m_slots.size(); ++i) {
+        if (m_slots[i].id == slotId) {
+            m_selected = i;
+            return;
+        }
+    }
+}
+
+const SaveSlotInfo& SaveSlotScreen::selectedSlot() const {
+    if (m_selected >= m_slots.size()) {
+        return kNoSlot;
+    }
+    return m_slots[m_selected];
+}
+
+SaveSlotAction SaveSlotScreen::confirm() {
+    const SaveSlotInfo& slot = selectedSlot();
+    m_message.clear();
+
+    // Segundo ENTER sobre la pregunta abierta: el jugador ya ha dicho que
+    // si. La pregunta se cierra y se devuelve Save con el consentimiento
+    // dado.
+    if (m_awaitingOverwrite) {
+        m_awaitingOverwrite = false;
+        m_prompt.clear();
+        return SaveSlotAction::Save;
+    }
+
+    if (slot.id.empty()) {
+        return SaveSlotAction::None;
+    }
+
+    if (m_mode == SaveSlotMode::Load) {
+        if (slot.status == SaveSlotStatus::Empty) {
+            m_message = "La ranura esta vacia.";
+            return SaveSlotAction::None;
+        }
+        if (slot.status == SaveSlotStatus::Broken) {
+            // Se enseña el motivo y NO se carga. La partida en curso ni se
+            // entera: aqui no se ha tocado nada.
+            m_message = slot.problemText;
+            return SaveSlotAction::None;
+        }
+        return SaveSlotAction::Load;
+    }
+
+    // Guardar. Una ranura ocupada -- aunque lo que tenga sea ilegible --
+    // pide confirmacion: pisar un fichero que el jugador cree que es su
+    // partida buena no puede pasar por accidente.
+    if (slot.status != SaveSlotStatus::Empty) {
+        m_awaitingOverwrite = true;
+        m_prompt = "¿Sobrescribir " + slot.label + "? (ENTER si, ESC no)";
+        return SaveSlotAction::Ask;
+    }
+    return SaveSlotAction::Save;
+}
+
+SaveSlotAction SaveSlotScreen::cancel() {
+    if (m_awaitingOverwrite) {
+        // Cancelar un sobrescrito NO cierra el selector y, sobre todo, no
+        // ha tocado el fichero: la escritura solo la hace quien recibe
+        // SaveSlotAction::Save.
+        m_awaitingOverwrite = false;
+        m_prompt.clear();
+        m_message = "Guardado cancelado.";
+        return SaveSlotAction::None;
+    }
+    return SaveSlotAction::Cancel;
+}
+
+void SaveSlotScreen::refresh(const SaveSlotService& service) {
+    const std::size_t previous = m_selected;
+    m_slots = service.listSlots();
+    m_selected = m_slots.empty() ? 0 : std::min(previous, m_slots.size() - 1);
+    m_awaitingOverwrite = false;
+    m_prompt.clear();
+}
+
+std::string SaveSlotScreen::describeLine(const SaveSlotInfo& info) {
+    std::string line = info.label;
+    switch (info.status) {
+        case SaveSlotStatus::Empty:
+            return line + "  - vacia -";
+        case SaveSlotStatus::Broken:
+            return line + "  [!] " + info.problemText;
+        case SaveSlotStatus::Ready:
+            break;
+    }
+    line += "  ";
+    line += info.characterName.empty() ? std::string("(sin nombre)") : info.characterName;
+    if (!info.levelPath.empty()) {
+        line += " - " + info.levelPath;
+    }
+    if (!info.savedAt.empty()) {
+        line += " - " + info.savedAt;
+    }
+    return line;
+}
+
+std::vector<std::string> SaveSlotScreen::labels() const {
+    std::vector<std::string> out;
+    out.reserve(m_slots.size());
+    for (const SaveSlotInfo& info : m_slots) {
+        out.push_back(describeLine(info));
+    }
+    return out;
+}
+
+}  // namespace Game
