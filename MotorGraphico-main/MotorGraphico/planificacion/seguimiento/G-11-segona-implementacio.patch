diff -ruN '--exclude=build' '--exclude=_glad_off' '--exclude=third_party' mg/include/Game/SaveSlotState.h mg-g11/include/Game/SaveSlotState.h
--- mg/include/Game/SaveSlotState.h	1970-01-01 00:00:00.000000000 +0000
+++ mg-g11/include/Game/SaveSlotState.h	2026-09-14 07:14:35.880129298 +0000
@@ -0,0 +1,320 @@
+#pragma once
+
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "Game/SaveGame.h"
+
+namespace RPG {
+class EventInterpreter;
+}
+
+class GameSession;
+
+namespace Game {
+
+// ---------------------------------------------------------------------
+// G-11 — Selector de guardados y recuperacion de derrota.
+//
+// Hasta aqui el juego solo tenia F5/F9 sobre UN fichero fijo
+// ("savegame.json", ver Application.h): ni ranuras visibles, ni
+// "Continuar", ni forma de volver de un Game Over que no fuera cerrar y
+// abrir. Este fichero es el SERVICIO que falta debajo de todo eso.
+//
+// GL-FREE A PROPOSITO, igual que TitleScreen/PauseMenu/GameOverScreen: el
+// servicio (SaveSlotService) hace disco y reglas, la pantalla
+// (SaveSlotScreen) lleva el estado de la seleccion, y la Application se
+// limita a pintarlas y a pasarles teclas. Asi el gruesso del paquete se
+// prueba entero sin abrir una ventana (tests/Game/SaveSlotTests.cpp).
+//
+//
+// DONDE VIVEN LOS SLOTS, Y POR QUE ASI
+//
+// Criterio de cierre: "dos projectes no comparteixen slots". La
+// separacion se hace por el NOMBRE DEL FICHERO y no por una carpeta por
+// proyecto:
+//
+//     <root>/partida_<projectId>_<slotId>.json
+//
+// Es la misma forma de resolver la identidad que ya usa el resto del
+// motor para los proyectos: ProjectIndex guarda cada manifiesto como
+// "assets/proyectos/<id>.json", con el id en el nombre; quien es dueño de
+// que se DECLARA en el nombre, no se deduce de donde este.
+//
+// Y sobre todo: este motor NO TIENE UN SOLO mkdir en src/ (lo dice
+// ProjectHub.h con esas palabras, y es coherente con que evite
+// <filesystem> por no arrastrar stdc++fs en algunos toolchains). Una
+// carpeta por proyecto obligaria a crearla, es decir a traer justo esa
+// dependencia para guardar cuatro ficheros. Con el id en el nombre no
+// hace falta crear nada: el root por defecto es "" = el directorio de
+// trabajo, que es exactamente donde vive hoy savegame.json.
+//
+// El root es un parametro, no una constante, para que el dia que el motor
+// tenga donde poner los datos del usuario baste con pasarselo.
+//
+//
+// POR QUE UNA LISTA FIJA DE RANURAS Y NO LEER LA CARPETA
+//
+// Por lo mismo que ProjectIndex lee un index.json en vez de escanear
+// assets/: sin <filesystem> no hay forma portable de listar un
+// directorio. Las ranuras son un numero fijo conocido (kNumberedSlots) +
+// la rapida de F5/F9, y "descubrirlas" es preguntar por cada una si su
+// fichero esta. Es ademas lo que el jugador espera de un menu de
+// guardado: las ranuras estan siempre, vacias o llenas.
+// ---------------------------------------------------------------------
+
+// En que estado esta una ranura de cara al selector.
+enum class SaveSlotStatus {
+    Empty,   // no hay fichero: se puede guardar, no se puede cargar
+    Ready,   // hay partida y se ha podido leer la ficha
+    Broken,  // hay fichero pero no sirve; el motivo va en SaveSlotInfo::problem
+};
+
+// Por que no sirve. El texto de problem() ya lo explica al jugador; esto
+// existe para que la pantalla pueda distinguirlos (iconos, color) y para
+// que la prueba pueda afirmar CUAL de los dos casos es.
+enum class SaveSlotProblem {
+    None,
+    Unreadable,      // no es JSON, o no es un guardado (sin schemaVersion, sin levelPath)
+    Incompatible,    // es un guardado, pero de otra version del esquema
+    ForeignProject,  // es un guardado valido de OTRO proyecto
+};
+
+// La fila que pinta el selector. Es un resumen: leerla NO carga la
+// partida ni toca la sesion en curso.
+struct SaveSlotInfo {
+    std::string id;     // "ranura_1".."ranura_3", "rapida"
+    std::string label;  // "Ranura 1", "Guardado rapido"
+    std::string path;   // fichero que le corresponde (exista o no)
+    bool quick = false;  // la que usan F5/F9
+
+    SaveSlotStatus status = SaveSlotStatus::Empty;
+    SaveSlotProblem problem = SaveSlotProblem::None;
+    std::string problemText;  // motivo exacto, vacio si status != Broken
+
+    // Ficha (solo con status == Ready).
+    std::string characterName;
+    std::string levelPath;
+    std::string savedAt;
+    int gold = 0;
+    int playerHealth = 0;
+    int playerMaxHealth = 0;
+
+    bool usable() const { return status == SaveSlotStatus::Ready; }
+};
+
+// DEC-09 — Resultado de preguntar "¿se puede guardar ahora?".
+struct SafePoint {
+    bool safe = false;
+    std::string reason;  // vacio si safe; si no, que lo impide, en claro
+};
+
+// Que hacer cuando el destino ya tiene partida.
+enum class SaveSlotWrite {
+    FailIfOccupied,  // por defecto: no se pisa nada sin confirmar
+    Overwrite,
+};
+
+struct SaveSlotWriteOutcome {
+    bool ok = false;
+    std::string problem;
+    // true cuando lo unico que falta es que el jugador confirme el
+    // sobrescrito. La pantalla lo usa para abrir la pregunta; quien llame
+    // al servicio a pelo lo usa para saber que no ha sido un error.
+    bool needsOverwriteConfirm = false;
+};
+
+struct SaveSlotLoadOutcome {
+    bool ok = false;
+    std::string problem;
+    SaveSlotProblem kind = SaveSlotProblem::None;
+    // Valido solo con ok == true. Se rellena ENTERO antes de devolverse:
+    // quien lo recibe ya no puede quedarse a medias.
+    SaveGameData data;
+};
+
+// ---------------------------------------------------------------------
+// El servicio. Un objeto por partida en curso (sabe de que proyecto es).
+// No dibuja nada y no depende de la Application.
+// ---------------------------------------------------------------------
+class SaveSlotService {
+public:
+    static constexpr int kNumberedSlots = 3;
+
+    // Identificadores = contrato (regla 6 del plan): minusculas y guiones
+    // bajos, y son los que acaban en el nombre del fichero.
+    static const char* quickSlotId();              // "rapida"
+    static std::string numberedSlotId(int index);  // 1 -> "ranura_1"
+
+    // root vacio = directorio de trabajo, que es donde guarda hoy F5.
+    explicit SaveSlotService(std::string projectId, std::string root = std::string());
+
+    const std::string& projectId() const { return m_projectId; }
+    const std::string& root() const { return m_root; }
+
+    // Ranuras en el orden en que se enseñan: las numeradas y la rapida al
+    // final (es la del automatismo, no la que el jugador elige primero).
+    std::vector<std::string> slotIds() const;
+    std::string slotPath(const std::string& slotId) const;
+
+    // Lee la ficha de una ranura. NUNCA falla: una ranura ilegible es un
+    // SaveSlotInfo con status Broken y su motivo, no un error que corte
+    // el menu. Esa es la mitad de "corruptes/incompatibles mostren motiu i
+    // no destrueixen la sessio": ni siquiera MIRAR los slots puede romper
+    // nada.
+    SaveSlotInfo describe(const std::string& slotId) const;
+    std::vector<SaveSlotInfo> listSlots() const;
+
+    // La ranura utilizable mas reciente, o "" si no hay ninguna. Es lo que
+    // necesita "Continuar" del titulo. Ordena por savedAt, que es texto
+    // "AAAA-MM-DD HH:MM:SS" y por tanto se ordena comparando cadenas; las
+    // que no traen fecha (guardados anteriores a G-11) pierden frente a
+    // las que si, pero siguen siendo candidatas si no hay otra cosa.
+    std::string mostRecentSlotId() const;
+
+    // --- DEC-09: puntos seguros ---
+    //
+    // NO HAY UNA BANDERA NUEVA. El estado que dice si se puede guardar ya
+    // existe repartido por el motor, y anadir un "bool m_puedeGuardar" que
+    // alguien tenga que acordarse de actualizar es exactamente la clase de
+    // bug que la fase C ha estado cerrando. Se DERIVA de:
+    //   - GameSession::mode(): solo Exploration es seguro. Combate,
+    //     dialogo, tienda, negocio, pausa y derrota no lo son.
+    //   - GameSession::pendingTransition(): a mitad de un cambio de nivel
+    //     la sesion que se fotografiaria ya no es la que se va a jugar.
+    //   - EventInterpreter::canSave(): el planificador de eventos ya
+    //     responde a esta pregunta desde E-03 (no hay ejecucion viva).
+    //     Puede ser nullptr: un juego sin eventos de mapa es seguro por
+    //     esa parte.
+    static SafePoint checkSafePoint(const GameSession& session,
+                                    const RPG::EventInterpreter* events = nullptr);
+
+    // --- Guardar ---
+
+    // Escribe un SaveGameData ya capturado. Estampa projectId y savedAt
+    // (la ficha del slot) antes de escribir: la fecha la pone quien
+    // guarda, no quien captura.
+    SaveSlotWriteOutcome write(const std::string& slotId, SaveGameData data,
+                               SaveSlotWrite mode = SaveSlotWrite::FailIfOccupied) const;
+
+    // Captura la sesion y la escribe, comprobando DEC-09 antes de tocar
+    // el disco. Si no es punto seguro no se escribe NADA y el motivo sale
+    // en problem.
+    SaveSlotWriteOutcome saveFrom(const std::string& slotId, const GameSession& session,
+                                  const std::string& levelPath,
+                                  const RPG::EventInterpreter* events = nullptr,
+                                  SaveSlotWrite mode = SaveSlotWrite::FailIfOccupied) const;
+
+    // --- Cargar ---
+
+    // Lee y valida SIN tocar nada vivo. Es la mitad "no destrueixen la
+    // sessio" del criterio: el fichero se lee entero y se valida entero
+    // antes de que exista un SaveGameData que alguien pueda aplicar.
+    SaveSlotLoadOutcome load(const std::string& slotId) const;
+
+    // Carga sobre una sesion VIVA. Orden de operaciones deliberado, el
+    // mismo todo-o-nada que usa ProjectIndex::duplicate y que
+    // GameSession::restoreSaveGame aplica por dentro (valida en fase 1,
+    // escribe en fase 2): primero se lee el fichero completo, y solo si
+    // eso sale bien se le entrega a la sesion. Un slot corrupto se queda
+    // en el primer paso y la partida en curso no se entera.
+    //
+    // OJO: restaurar sobre una sesion cuyo nivel no es data.levelPath
+    // falla (lo comprueba restoreSaveGame) y tampoco toca nada. Cambiar de
+    // nivel es cosa de quien orquesta (la Application), no del servicio:
+    // GameSession no hace I/O y este servicio no carga niveles.
+    bool restoreInto(const std::string& slotId, GameSession& session,
+                     std::string* problem = nullptr) const;
+
+    // Reloj inyectable. Por defecto la hora local del sistema; los tests
+    // lo fijan para que la ficha del slot sea comparable sin depender del
+    // reloj de la maquina.
+    void setClock(std::function<std::string()> clock);
+    std::string nowStamp() const;
+
+    // "AAAA-MM-DD HH:MM:SS" de la hora local, formato de SaveGameData::savedAt.
+    static std::string localTimeStamp();
+
+private:
+    std::string m_projectId;
+    std::string m_root;
+    std::function<std::string()> m_clock;
+};
+
+// ---------------------------------------------------------------------
+// La pantalla. SOLO ESTADO: que ranura esta marcada, si hay una pregunta
+// de sobrescritura abierta y que hay que decirle al jugador. No dibuja y
+// no escribe en disco -- quien confirma ejecuta la accion que devuelve
+// confirm() usando el servicio.
+//
+// Mismo patron y mismo lenguaje de teclas que TitleScreen / PauseMenu /
+// GameOverScreen (W/S + ENTER, navegacion con wraparound).
+// ---------------------------------------------------------------------
+
+// Para que se ha abierto el selector.
+enum class SaveSlotMode { Load, Save };
+
+// Que hay que hacer despues de confirmar.
+enum class SaveSlotAction {
+    None,     // no ha pasado nada util (ranura vacia al cargar, rota, etc.)
+    Ask,      // se acaba de abrir la pregunta de sobrescritura: no hagas nada aun
+    Save,     // guarda en selectedSlot(), con sobrescritura ya consentida
+    Load,     // carga selectedSlot()
+    Cancel,   // cerrar el selector sin tocar nada
+};
+
+class SaveSlotScreen {
+public:
+    // La lista se toma UNA vez al abrir (es una foto, como el resto de
+    // pantallas del juego) y se refresca con refresh() despues de guardar.
+    static SaveSlotScreen open(const SaveSlotService& service, SaveSlotMode mode);
+
+    SaveSlotMode mode() const { return m_mode; }
+    const std::vector<SaveSlotInfo>& slots() const { return m_slots; }
+
+    void moveUp();
+    void moveDown();
+    std::size_t selected() const { return m_selected; }
+
+    // Coloca el cursor en una ranura concreta (p.ej. la mas reciente, que
+    // es donde "Continuar" quiere empezar). No-op si el id no existe.
+    void select(const std::string& slotId);
+
+    const SaveSlotInfo& selectedSlot() const;
+    std::string selectedSlotId() const { return selectedSlot().id; }
+
+    // ¿Hay una pregunta de sobrescritura abierta?
+    bool awaitingOverwrite() const { return m_awaitingOverwrite; }
+    // Texto de la pregunta, o "" si no hay ninguna abierta.
+    const std::string& prompt() const { return m_prompt; }
+    // Ultimo motivo a enseñar (ranura vacia, corrupta, version...).
+    const std::string& message() const { return m_message; }
+
+    // ENTER. Cambia el estado interno y dice que hay que hacer.
+    SaveSlotAction confirm();
+
