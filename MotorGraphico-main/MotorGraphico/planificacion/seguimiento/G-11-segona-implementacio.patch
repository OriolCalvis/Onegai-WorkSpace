+// ---------------------------------------------------------------------
+// 1. Dos proyectos no comparten ranuras
+// ---------------------------------------------------------------------
+
+MOTOR_TEST_CASE(dos_proyectos_no_comparten_ranuras) {
+    SaveSlotService uno = serviceFor("g11_proyecto_uno", "2026-01-01 10:00:00");
+    SaveSlotService dos = serviceFor("g11_proyecto_dos", "2026-01-01 10:00:00");
+    wipe(uno);
+    wipe(dos);
+
+    const std::string ranura = SaveSlotService::numberedSlotId(1);
+    MOTOR_CHECK(uno.slotPath(ranura) != dos.slotPath(ranura));
+
+    Partida a;
+    a.session.addGold(111);
+    MOTOR_CHECK(uno.saveFrom(ranura, a.session, "assets/levels/uno.json").ok);
+
+    // La ranura 1 del OTRO proyecto sigue vacia, y la lista entera tambien.
+    MOTOR_CHECK(uno.describe(ranura).status == SaveSlotStatus::Ready);
+    MOTOR_CHECK(dos.describe(ranura).status == SaveSlotStatus::Empty);
+    for (const SaveSlotInfo& info : dos.listSlots()) {
+        MOTOR_CHECK(info.status == SaveSlotStatus::Empty);
+    }
+
+    // Y guardar en el segundo no pisa el primero.
+    Partida b;
+    b.session.addGold(222);
+    MOTOR_CHECK(dos.saveFrom(ranura, b.session, "assets/levels/dos.json").ok);
+    MOTOR_CHECK(uno.describe(ranura).gold == 111);
