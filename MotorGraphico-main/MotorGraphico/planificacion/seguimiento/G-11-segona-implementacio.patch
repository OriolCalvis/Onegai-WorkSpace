+
+bool Application::saveToSlot(const std::string& slotId, bool overwrite) {
+    if (m_session == nullptr) {
+        return false;
+    }
+    // DEC-09 lo comprueba saveFrom ANTES de abrir el fichero: si no es
+    // punto seguro no se escribe nada y el motivo llega al log del HUD.
+    // El planificador de eventos de E-03 todavia no cuelga de la
+    // Application, asi que por esa via se pasa nullptr; el dia que
+    // cuelgue, este es el unico sitio que hay que tocar.
+    const Game::SaveSlotWriteOutcome outcome = saveSlots().saveFrom(
+        slotId, *m_session, m_currentLevelPath, /*events=*/nullptr,
+        overwrite ? Game::SaveSlotWrite::Overwrite : Game::SaveSlotWrite::FailIfOccupied);
+    if (!outcome.ok) {
+        m_session->logNote(outcome.problem);
+        trace(("saveToSlot: " + outcome.problem).c_str());
+        return false;
+    }
+    m_session->logNote("Partida guardada.");
+    return true;
+}
+
+bool Application::loadFromSlot(const std::string& slotId) {
+    // Se lee y se valida el fichero ENTERO antes de pedir el cambio de
+    // escena: una ranura corrupta o de otra version se queda aqui y la
+    // partida en curso sigue exactamente como estaba.
+    const Game::SaveSlotLoadOutcome outcome = saveSlots().load(slotId);
+    if (!outcome.ok) {
+        if (m_session != nullptr) {
+            m_session->logNote("No se pudo cargar: " + outcome.problem);
+        }
+        trace(("loadFromSlot: " + outcome.problem).c_str());
+        return false;
+    }
+
+    const SaveGameData data = outcome.data;
+    const auto requested = m_scenes.requestReplace(makeScene(false, [this, data] {
+        auto loaded = loadLevel(data.levelPath, false, GridCoord{}, [this, &data] {
+            m_narrativeState.reset();
+            applyNarrativeState(data, m_narrativeState);
+        }, &data);
+        if (loaded.isOk() && m_session != nullptr) {
+            m_session->logNote("Partida cargada.");
+        }
+        return loaded;
+    }));
+    return requested.isOk();
+}
+
+void Application::openSlotSelector(Game::SaveSlotMode mode) {
+    m_slotScreen = std::make_unique<Game::SaveSlotScreen>(
+        Game::SaveSlotScreen::open(saveSlots(), mode));
+    // Al cargar, el cursor empieza en la partida mas reciente: es la que
+    // el jugador quiere nueve de cada diez veces, y es lo que permite que
+    // "Continuar" y "Cargar partida" sean el MISMO selector.
+    const std::string recent = saveSlots().mostRecentSlotId();
+    if (mode == Game::SaveSlotMode::Load && !recent.empty()) {
+        m_slotScreen->select(recent);
+    }
+    refreshSlotWidgets();
+}
+
+void Application::closeSlotSelector() {
+    m_slotScreen.reset();
+    refreshSlotWidgets();
+}
+
+void Application::confirmSlotSelection() {
+    if (!m_slotScreen || m_scenes.hasPendingTransition()) {
+        return;
+    }
+    // El id se lee ANTES de confirmar, para que quede claro sobre que
+    // ranura se actua aunque confirm() cambie el estado interno.
+    const std::string slotId = m_slotScreen->selectedSlotId();
+    switch (m_slotScreen->confirm()) {
+        case Game::SaveSlotAction::Save:
+            // Llegar aqui YA es el consentimiento: o la ranura estaba
+            // vacia, o el jugador acaba de contestar que si.
+            if (saveToSlot(slotId, /*overwrite=*/true)) {
+                closeSlotSelector();
+            } else {
+                m_slotScreen->refresh(saveSlots());
+                refreshSlotWidgets();
+            }
+            break;
+        case Game::SaveSlotAction::Load:
+            if (loadFromSlot(slotId)) {
+                closeSlotSelector();
+            } else {
+                m_slotScreen->refresh(saveSlots());
+                refreshSlotWidgets();
+            }
+            break;
+        case Game::SaveSlotAction::Cancel:
+            closeSlotSelector();
+            break;
+        case Game::SaveSlotAction::Ask:
+        case Game::SaveSlotAction::None:
+            // Pregunta abierta, o motivo que enseñar (ranura vacia,
+            // corrupta, de otra version): no se toca nada, solo se repinta.
+            refreshSlotWidgets();
+            break;
+    }
+}
+
+void Application::refreshSlotWidgets() {
+    if (m_slotMenu == nullptr) {
+        return;  // init() todavia no ha compuesto el HUD
+    }
+    const bool open = slotSelectorOpen();
+    if (open) {
+        m_slotMenu->setOptions(m_slotScreen->labels());
+        m_slotMenu->setSelectedIndex(m_slotScreen->selected());
+        if (m_slotTitle != nullptr) {
+            m_slotTitle->setText(m_slotScreen->mode() == Game::SaveSlotMode::Save
+                                     ? "GUARDAR PARTIDA"
+                                     : "CARGAR PARTIDA");
+        }
+        if (m_slotHint != nullptr) {
+            // La pregunta de sobrescritura manda sobre el ultimo motivo, y
+            // los dos sobre la ayuda de teclas: lo urgente arriba.
+            std::string hint = m_slotScreen->awaitingOverwrite() ? m_slotScreen->prompt()
+                                                                 : m_slotScreen->message();
+            if (hint.empty()) {
+                hint = "W/S ELEGIR - ENTER CONFIRMAR - ESC CERRAR";
+            }
+            m_slotHint->setText(hint);
+        }
+    }
+    IHudElement* widgets[] = {m_slotPanel.get(), m_slotTitle.get(), m_slotMenu.get(),
+                              m_slotHint.get()};
+    for (IHudElement* widget : widgets) {
+        if (widget != nullptr) {
+            widget->setVisible(open);
+        }
+    }
+}
