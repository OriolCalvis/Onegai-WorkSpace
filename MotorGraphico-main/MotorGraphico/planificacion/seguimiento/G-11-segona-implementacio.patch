+    const SaveSlotInfo falsa = service.describe(SaveSlotService::numberedSlotId(2));
+    MOTOR_CHECK(falsa.status == SaveSlotStatus::Broken);
+    MOTOR_CHECK(falsa.problem == SaveSlotProblem::Unreadable);
+
+    // Una ranura rota no arrastra a las demas: la lista sigue completa.
+    const auto slots = service.listSlots();
+    MOTOR_CHECK(slots.size() == static_cast<std::size_t>(SaveSlotService::kNumberedSlots) + 1);
+
+    wipe(service);
+}
